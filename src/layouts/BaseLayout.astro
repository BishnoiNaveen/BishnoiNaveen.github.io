---
/**
 * BaseLayout.astro — Backward compatibility forwarder to Layout.astro.
 */
import Layout from './Layout.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  keywords?: string[];
}

const props = Astro.props;
---

<Layout {...props}>
  <slot name="header" slot="header" />
  <slot />
  <slot name="footer" slot="footer" />
</Layout>
