---
/**
 * src/layouts/Layout.astro — Clean alias / adapter for BaseLayout.astro
 * Ensures backward compatibility across all site routes while adhering
 * to the Master Design System & Apple Light/Dark material architecture.
 */
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  keywords?: string[];
  type?: string;
  publishedTime?: string;
  noindex?: boolean;
}

const {
  ogImage = '/images/portfolio_hero.jpg',
  ...rest
} = Astro.props;
---

<BaseLayout ogImage={ogImage} {...rest}>
  <slot name="header" slot="header" />
  <slot />
  <slot name="footer" slot="footer" />
</BaseLayout>
