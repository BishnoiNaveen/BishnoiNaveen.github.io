---
/**
 * src/pages/skills.astro — Dedicated Skills & Technical Architecture Page
 * 5 Core Technical Pillars & Real-World Engineering Proficiencies
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import Footer from '../components/contact/Footer.astro';
import { skillDomains } from '../data/skills';
---

<BaseLayout
  title="Technical Skills & Architecture · Naveen Bishnoi"
  description="Comprehensive technical proficiencies, systems architecture, and engineering domains of Naveen Bishnoi — AI Automation, Python Analytics, Cloudflare Workers, and Systems Programming."
>
  <FloatingNav client:load slot="header" />

  <main class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-36 pb-24">
    {/* Page Header */}
    <div class="mb-14 sm:mb-20 pb-8 border-b border-black/[0.08] dark:border-white/10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800 text-purple-700 dark:text-purple-300 text-xs font-semibold tracking-wide uppercase mb-4">
        <span>03 &middot; Technical Stack &amp; Skills</span>
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[var(--color-text-primary)] leading-[1.1] mb-6">
        5 Core Engineering Pillars.
      </h1>
      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] font-normal leading-relaxed max-w-3xl">
        Every skill listed here is grounded in real production work at KRONE Agriculture India, full-stack systems projects, or verified academic foundations.
      </p>
    </div>

    {/* 5 Domains Grid */}
    <div class="space-y-16">
      {skillDomains.map((domain, idx) => (
        <section class="p-6 sm:p-8 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 shadow-sm relative overflow-hidden">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-black/[0.06] dark:border-white/[0.08]">
            <div>
              <span class="text-xs font-mono font-bold tracking-wider text-blue-600 dark:text-blue-400 uppercase block mb-1">
                {domain.badge}
              </span>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)]">
                {domain.title}
              </h2>
              <p class="text-sm font-medium text-[var(--color-text-muted)] mt-1">
                {domain.subtitle}
              </p>
            </div>
          </div>

          <p class="text-sm sm:text-base text-[var(--color-text-secondary)] leading-relaxed mt-4 mb-6">
            {domain.lead}
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {domain.skills.map((skill) => (
              <div class="p-5 rounded-2xl bg-black/[0.02] dark:bg-white/[0.02] border border-black/[0.05] dark:border-white/[0.06] flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <h3 class="text-base font-bold text-[var(--color-text-primary)]">{skill.name}</h3>
                    <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-300">
                      {skill.level}
                    </span>
                  </div>
                  <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed mb-4">
                    {skill.description}
                  </p>
                </div>

                <div class="pt-3 border-t border-black/[0.06] dark:border-white/[0.08] space-y-3">
                  <div class="text-[11px] text-[var(--color-text-muted)] flex items-start gap-1.5">
                    <strong class="font-semibold text-[var(--color-text-primary)] shrink-0">Proof:</strong>
                    <span>{skill.evidenceProof}</span>
                  </div>

                  <div class="flex flex-wrap gap-1.5">
                    {skill.tags.map((tag) => (
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-black/[0.04] dark:bg-white/[0.08] text-[var(--color-text-secondary)]">
                        {tag}
                      </span>
                    ))}
                  </div>

                  {skill.repoUrl && (
                    <a
                      href={skill.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline pt-1"
                    >
                      <span>View GitHub Repository &rarr;</span>
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      {/* Navigation Links */}
      <section class="mt-16 p-8 rounded-3xl bg-gradient-to-br from-purple-500/10 via-blue-500/5 to-emerald-500/10 border border-purple-500/20 text-center flex flex-col items-center">
        <h3 class="text-2xl font-bold text-[var(--color-text-primary)] mb-2">See these skills in real projects</h3>
        <p class="text-sm sm:text-base text-[var(--color-text-secondary)] max-w-xl mb-6">
          Explore complete project architectures, inspect verified credentials from IBM and Deloitte, or download the full resume.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/projects"
            class="px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all"
          >
            Explore Projects &rarr;
          </a>
          <a
            href="/credentials"
            class="px-5 py-2.5 rounded-full bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold shadow-sm transition-all"
          >
            Verified Credentials &rarr;
          </a>
          <a
            href="/naveen_bishnoi_resume.pdf"
            download="naveen_bishnoi_resume.pdf"
            class="px-5 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-sm transition-all"
          >
            Download Resume (PDF) &darr;
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
