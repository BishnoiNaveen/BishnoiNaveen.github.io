---
/**
 * src/pages/contact.astro — Dedicated Contact & Communication Showcase
 * Author: Naveen Bishnoi
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import ContactTerminal from '../components/contact/ContactTerminal';
import Footer from '../components/contact/Footer.astro';
---

<BaseLayout
  title="Contact & Advisory | Naveen Bishnoi"
  description="Direct communication with Naveen Bishnoi — Software Architect, Systems Engineer & AI Automation Craftsman. Response SLA < 24 hours guaranteed."
>
  <FloatingNav client:load slot="header" />

  <div class="w-full min-h-screen bg-[var(--color-canvas)] text-[var(--color-text-primary)] pt-32 pb-24 px-4 sm:px-6 md:px-12 lg:px-16 flex flex-col justify-center">
    <div class="max-w-[96rem] mx-auto w-full">
      <ContactTerminal client:load />
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
