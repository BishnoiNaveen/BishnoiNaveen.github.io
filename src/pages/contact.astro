---
/**
 * src/pages/contact.astro — Clean Minimalist Contact Page
 * Author: Naveen Bishnoi
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import CleanContact from '../components/contact/CleanContact.astro';
import Footer from '../components/contact/Footer.astro';
---

<BaseLayout
  title="Contact | Naveen Bishnoi · AI Systems & Cloud Backend Engineer"
  description="Get in touch with Naveen Bishnoi — AI Systems & Cloud Backend Engineer at KRONE Agriculture India."
>
  <FloatingNav client:load slot="header" />

  <main class="relative z-10 max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 pt-32 pb-24">
    <CleanContact />
  </main>

  <Footer slot="footer" />
</BaseLayout>
