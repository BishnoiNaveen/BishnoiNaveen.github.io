---
/**
 * src/pages/resume.astro — Clean Minimalist Resume Page
 * Author: Naveen Bishnoi
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import ReadingProgress from '../components/ui/ReadingProgress';
import CleanExperience from '../components/experience/CleanExperience.astro';
import CleanSkills from '../components/about/CleanSkills.astro';
import Footer from '../components/contact/Footer.astro';
---

<BaseLayout
  title="Resume | Naveen Bishnoi · Software Architect & Systems Engineer"
  description="Verified engineering career trajectory, technical proficiencies, and resume of Naveen Bishnoi — Software Architect & Systems Engineer at KRONE Agriculture India."
>
  <ReadingProgress client:load />
  <FloatingNav client:load slot="header" />

  <main class="relative z-10 max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 pt-32 pb-24 space-y-16">
    {/* Header with Direct Download Action */}
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-8 border-b border-black/[0.06] dark:border-white/[0.08]">
      <div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[var(--color-text-primary)] mb-3">
          Resume &amp; Experience
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-text-secondary)]">
          Naveen Bishnoi &middot; Software Architect &amp; Systems Engineer
        </p>
      </div>

      <a
        href="/Naveen_Bishnoi_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[var(--color-accent)] text-white text-sm font-semibold shadow-sm hover:opacity-90 active:scale-[0.98] transition-all shrink-0"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download PDF Resume</span>
      </a>
    </div>

    {/* Work Experience */}
    <CleanExperience />

    {/* Technical Skills */}
    <CleanSkills />
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
  @media print {
    header, footer, nav, button, a[href$=".pdf"] {
      display: none !important;
    }
    body {
      background: #ffffff !important;
      color: #000000 !important;
    }
    main {
      padding-top: 0 !important;
      max-width: 100% !important;
    }
    .rounded-3xl {
      border: 1px solid #e5e5e5 !important;
      box-shadow: none !important;
      background: #ffffff !important;
      break-inside: avoid;
    }
  }
</style>
