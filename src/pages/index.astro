---
/**
 * src/pages/index.astro — Clean Minimalist Portfolio Homepage
 * Author: Naveen Bishnoi
 * Standard: Minimal details on front page, rich colors, beautiful UI/UX,
 * with clean gateway portals leading to dedicated detailed webpages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import Footer from '../components/contact/Footer.astro';
import { bioData } from '../data/bio';
---

<BaseLayout
  title="Naveen Bishnoi · AI Systems & Cloud Backend Engineer"
  description="Personal engineering portfolio of Naveen Bishnoi — AI Systems & Cloud Backend Automation Engineer at KRONE Agriculture India. Enterprise billing, cloud microservices, and 50Hz telematics."
>
  <FloatingNav client:load slot="header" />

  <main class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-36 pb-24">
    
    {/* HERO SECTION: Minimal, Clean, Rich Colors */}
    <section class="mb-20 sm:mb-28 text-left">
      {/* Live Availability Badge */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full mb-6 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-xs font-semibold text-emerald-700 dark:text-emerald-300 select-none shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Available for AI Systems &amp; Cloud Backend Engineering Roles</span>
      </div>

      {/* Main Title & Role */}
      <div class="space-y-3 mb-6">
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-[var(--color-text-primary)] leading-[1.06]">
          Naveen Bishnoi
        </h1>
        <p class="text-xl sm:text-2xl lg:text-3xl font-bold bg-gradient-to-r from-blue-600 via-indigo-600 to-emerald-600 bg-clip-text text-transparent">
          AI Systems &amp; Cloud Backend Engineer
        </p>
      </div>

      {/* Plain, Simple, Indian English Bio */}
      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] font-normal leading-relaxed max-w-2xl mb-8">
        I build software that runs quietly and reliably in production &mdash; from automated enterprise billing portals and 50Hz machine telematics at <strong>KRONE Agriculture India</strong> to Python data pipelines and AI agent workflows.
      </p>

      {/* Verified Stats Strip — Rich Colors, Zero Clutter */}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-2xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 shadow-sm mb-10">
        <div>
          <span class="block text-2xl sm:text-3xl font-black text-blue-600 dark:text-blue-400 font-mono">5+ Mos</span>
          <span class="text-xs text-[var(--color-text-muted)] font-medium">KRONE Production Experience</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400 font-mono">326+</span>
          <span class="text-xs text-[var(--color-text-muted)] font-medium">Machines Telematics Monitored</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-black text-purple-600 dark:text-purple-400 font-mono">520+</span>
          <span class="text-xs text-[var(--color-text-muted)] font-medium">Service Jobs Automated (100% Audit)</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-black text-amber-600 dark:text-amber-400 font-mono">2026</span>
          <span class="text-xs text-[var(--color-text-muted)] font-medium">Panjab University BCA</span>
        </div>
      </div>

      {/* Direct Call to Action Buttons */}
      <div class="flex flex-wrap items-center gap-3.5">
        <a
          href="/naveen_bishnoi_resume.pdf"
          download="naveen_bishnoi_resume.pdf"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-md shadow-blue-500/20 active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Resume (PDF)</span>
        </a>

        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-black/[0.04] dark:bg-white/[0.08] hover:bg-black/[0.08] dark:hover:bg-white/[0.12] border border-black/[0.08] dark:border-white/[0.12] text-[var(--color-text-primary)] text-sm font-semibold transition-all active:scale-[0.98] cursor-pointer"
        >
          <span>Get in Touch &rarr;</span>
        </a>

        <a
          href="/resume"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-3.5 rounded-full text-sm font-medium text-[var(--color-text-secondary)] hover:text-blue-600 transition-colors"
        >
          <span>View Online Resume</span>
        </a>
      </div>
    </section>

    {/* SECTION PORTALS: Minimal, Clean, Rich Colors, Gateway to Separate Dedicated Webpages */}
    <section class="space-y-6">
      <div class="pb-4 border-b border-black/[0.08] dark:border-white/10 flex items-center justify-between">
        <div>
          <span class="text-xs font-mono font-bold tracking-wider text-blue-600 dark:text-blue-400 uppercase">
            Directory &middot; Dedicated Detailed Pages
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text-primary)] mt-0.5">
            Explore Each Section in Full Detail
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        
        {/* Portal 1: About */}
        <a
          href="/about"
          class="group p-6 sm:p-7 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 hover:border-blue-500/40 hover:-translate-y-1 transition-all duration-300 shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300">
                01 &middot; About
              </span>
              <span class="text-xs text-blue-600 dark:text-blue-400 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Read Story &rarr;
              </span>
            </div>
            <h3 class="text-xl font-extrabold text-[var(--color-text-primary)] group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
              Background &amp; Philosophy
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed font-normal">
              My journey from Abohar, Punjab to Panjab University and solving real production problems at KRONE Agriculture India. Grounded in zero guessing and mathematical invariants.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.04] dark:border-white/[0.04] flex items-center gap-2 text-xs font-mono text-[var(--color-text-muted)]">
            <span>Core Values</span>
            <span>&middot;</span>
            <span>Real-World Systems</span>
            <span>&middot;</span>
            <span>No Buzzwords</span>
          </div>
        </a>

        {/* Portal 2: Experience */}
        <a
          href="/experience"
          class="group p-6 sm:p-7 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 hover:border-emerald-500/40 hover:-translate-y-1 transition-all duration-300 shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300">
                02 &middot; Experience
              </span>
              <span class="text-xs text-emerald-600 dark:text-emerald-400 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                View Career &rarr;
              </span>
            </div>
            <h3 class="text-xl font-extrabold text-[var(--color-text-primary)] group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-2">
              KRONE Agriculture &amp; ITTECHXPERT
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed font-normal">
              Production engineering on enterprise billing (billing.kroneindia.com), KIN OneHub employee intranet on Cloudflare Workers, 199+ Fieldy FSM APIs, and 50Hz SocketCAN telematics across 326+ machines.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.04] dark:border-white/[0.04] flex items-center gap-2 text-xs font-mono text-[var(--color-text-muted)]">
            <span>5+ Mos Production</span>
            <span>&middot;</span>
            <span>520+ Jobs</span>
            <span>&middot;</span>
            <span>100% Audit</span>
          </div>
        </a>

        {/* Portal 3: Projects */}
        <a
          href="/projects"
          class="group p-6 sm:p-7 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 hover:border-indigo-500/40 hover:-translate-y-1 transition-all duration-300 shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-indigo-100 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300">
                03 &middot; Projects
              </span>
              <span class="text-xs text-indigo-600 dark:text-indigo-400 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Explore Code &rarr;
              </span>
            </div>
            <h3 class="text-xl font-extrabold text-[var(--color-text-primary)] group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-2">
              Real-World Engineering Projects
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed font-normal">
              Smart Task System (Next.js &amp; dual AI fallbacks), Gas Agency ERP (C99 core &amp; MySQL O(log N) indexing), AgriBridge India web portal, and KRONE enterprise billing.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.04] dark:border-white/[0.04] flex items-center gap-2 text-xs font-mono text-[var(--color-text-muted)]">
            <span>Next.js</span>
            <span>&middot;</span>
            <span>C99</span>
            <span>&middot;</span>
            <span>PostgreSQL</span>
            <span>&middot;</span>
            <span>Prisma</span>
          </div>
        </a>

        {/* Portal 4: Skills */}
        <a
          href="/skills"
          class="group p-6 sm:p-7 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 hover:border-purple-500/40 hover:-translate-y-1 transition-all duration-300 shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300">
                04 &middot; Skills
              </span>
              <span class="text-xs text-purple-600 dark:text-purple-400 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Inspect Stack &rarr;
              </span>
            </div>
            <h3 class="text-xl font-extrabold text-[var(--color-text-primary)] group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors mb-2">
              5 Technical Competency Pillars
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed font-normal">
              AI-driven automation, Python forensic analytics (pandas, NumPy), Cloudflare Workers serverless edge, PostgreSQL 3NF database architecture, and SocketCAN 50Hz telematics.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.04] dark:border-white/[0.04] flex items-center gap-2 text-xs font-mono text-[var(--color-text-muted)]">
            <span>AI Agents</span>
            <span>&middot;</span>
            <span>Python</span>
            <span>&middot;</span>
            <span>Cloudflare</span>
            <span>&middot;</span>
            <span>SQL 3NF</span>
          </div>
        </a>

        {/* Portal 5: Credentials */}
        <a
          href="/credentials"
          class="group p-6 sm:p-7 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 hover:border-cyan-500/40 hover:-translate-y-1 transition-all duration-300 shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-cyan-100 dark:bg-cyan-950/80 text-cyan-700 dark:text-cyan-300">
                05 &middot; Credentials
              </span>
              <span class="text-xs text-cyan-600 dark:text-cyan-400 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Verify Proof &rarr;
              </span>
            </div>
            <h3 class="text-xl font-extrabold text-[var(--color-text-primary)] group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors mb-2">
              Education &amp; Industry Certifications
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed font-normal">
              Panjab University BCA (Batch 2026), IBM Python for Data Science (Credly ID), and Deloitte Data Analytics &amp; Forensic Technology simulation.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.04] dark:border-white/[0.04] flex items-center gap-2 text-xs font-mono text-[var(--color-text-muted)]">
            <span>IBM Credly</span>
            <span>&middot;</span>
            <span>Deloitte</span>
            <span>&middot;</span>
            <span>Panjab University</span>
          </div>
        </a>

        {/* Portal 6: Contact */}
        <a
          href="/contact"
          class="group p-6 sm:p-7 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 hover:border-rose-500/40 hover:-translate-y-1 transition-all duration-300 shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-rose-100 dark:bg-rose-950/80 text-rose-700 dark:text-rose-300">
                06 &middot; Contact
              </span>
              <span class="text-xs text-rose-600 dark:text-rose-400 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Get in Touch &rarr;
              </span>
            </div>
            <h3 class="text-xl font-extrabold text-[var(--color-text-primary)] group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors mb-2">
              Direct Contact &amp; Inquiries
            </h3>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed font-normal">
              Reach out directly for software engineering opportunities, architectural discussions, or consulting. Fast response via email, phone, or LinkedIn.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.04] dark:border-white/[0.04] flex items-center gap-2 text-xs font-mono text-[var(--color-text-muted)]">
            <span>+91 9478334329</span>
            <span>&middot;</span>
            <span>0029bishnoinaveen@gmail.com</span>
          </div>
        </a>

      </div>
    </section>

    {/* Bottom Callout: Fast Resume Download */}
    <section class="mt-16 p-8 rounded-3xl bg-gradient-to-br from-blue-600/10 via-indigo-600/5 to-emerald-600/10 border border-blue-500/20 text-center flex flex-col items-center">
      <h3 class="text-2xl font-bold text-[var(--color-text-primary)] mb-2">
        Need a quick copy of my resume?
      </h3>
      <p class="text-sm sm:text-base text-[var(--color-text-secondary)] max-w-xl mb-6">
        Download the verified ATS-unrejectable PDF resume directly to your device.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/naveen_bishnoi_resume.pdf"
          download="naveen_bishnoi_resume.pdf"
          class="px-6 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-md transition-all active:scale-[0.98]"
        >
          Download naveen_bishnoi_resume.pdf &darr;
        </a>
        <a
          href="/resume"
          class="px-6 py-3.5 rounded-full bg-white dark:bg-white/10 hover:bg-black/[0.05] text-[var(--color-text-primary)] border border-black/[0.08] dark:border-white/10 text-sm font-semibold transition-all"
        >
          View Online Resume &rarr;
        </a>
      </div>
    </section>

  </main>

  <Footer slot="footer" />
</BaseLayout>
