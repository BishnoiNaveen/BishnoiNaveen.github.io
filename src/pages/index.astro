---
/**
 * index.astro - Home page for Naveen Bishnoi Portfolio.
 */
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav';
import Hero from '../components/Hero';
import HomeSkills from '../components/HomeSkills';
---

<Layout 
  title="Naveen Bishnoi | Software Architect & AI Automation Engineer" 
  description="Naveen Bishnoi - Developer, AI Automation Engineer & Systems Builder."
>
  <HeaderNav client:load />

  <main class="flex flex-col w-full min-h-screen bg-transparent">
    <Hero client:load />
    
    <HomeSkills client:load />
    
    <!-- Infinite Marquee -->
    <div class="relative w-full py-8 border-y border-white/5 bg-black/50 overflow-hidden flex items-center z-10 mt-auto">
      <div class="animate-marquee whitespace-nowrap flex gap-12 text-zinc-600 font-black text-2xl uppercase tracking-widest mix-blend-difference">
        {Array(10).fill('SYSTEM ARCHITECTURE • AI AUTOMATION • DISTRIBUTED SYSTEMS • REACT • FASTAPI • KAFKA • ').map(text => (
          <span>{text}</span>
        ))}
      </div>
    </div>

    <!-- Footer Teaser -->
    <footer class="w-full py-12 bg-[#09090b] relative z-10">
      <div class="max-w-[100rem] mx-auto px-6 md:px-12 flex flex-col md:flex-row justify-between items-center gap-6">
        <p class="text-sm text-zinc-500 font-medium text-center md:text-left">
          &copy; {new Date().getFullYear()} Naveen Bishnoi. All rights reserved.
        </p>
        <div class="flex gap-8 justify-center">
          <a href="https://github.com/BishnoiNaveen" target="_blank" rel="noreferrer" class="text-sm font-bold text-zinc-500 hover:text-white transition-colors uppercase tracking-widest hover:scale-105">GitHub</a>
          <a href="https://linkedin.com/in/naveen-bishnoi" target="_blank" rel="noreferrer" class="text-sm font-bold text-zinc-500 hover:text-white transition-colors uppercase tracking-widest hover:scale-105">LinkedIn</a>
          <a href="mailto:0029bishnoinaveen@gmail.com" class="text-sm font-bold text-zinc-500 hover:text-white transition-colors uppercase tracking-widest hover:scale-105">Email</a>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
</style>
