---
/**
 * index.astro — BEAST MODE: Dark Luxury AI Portfolio
 * 8 Chapters · Cinematic Scroll · Glass + Gradient Throughout
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import CinematicExperience from '../experience/CinematicExperience';
import CinematicHero from '../components/hero/CinematicHero.astro';
import TypographicManifesto from '../components/manifesto/TypographicManifesto.astro';
import Projects from '../components/Projects';
import LabSection from '../components/lab/LabSection.astro';
import AboutSection from '../components/about/AboutSection.astro';
import SkillsSection from '../components/about/SkillsSection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import Footer from '../components/contact/Footer.astro';
---

<BaseLayout
  title="Naveen Bishnoi | Software Architect & AI Systems Engineer"
  description="Personal Brand & Systems Architecture Showcase of Naveen Bishnoi — Software Architect, AI Automation Engineer, and Systems Builder at KRONE Agriculture India."
>
  {/* Floating Navigation */}
  <FloatingNav slot="header" />

  {/* CINEMATIC 3D JOURNEY */}
  <CinematicExperience client:only="react" scrollTrackHeight="700vh" />

  {/* ── ALL EDITORIAL SECTIONS — Dark Luxury ── */}
  <div class="relative w-full overflow-hidden" style="background: #020208; color: #f8fafc;">

    {/* Chapter 01: Hero */}
    <div class="chapter-reveal is-revealed" data-chapter="1">
      <CinematicHero />
    </div>

    {/* Gradient Divider */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 02: Typographic Manifesto */}
    <div class="chapter-reveal stagger-reveal" data-chapter="2"
      style="background: linear-gradient(180deg, #020208 0%, #05050f 100%); position:relative;">
      {/* Mesh orb */}
      <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 w-[500px] h-[500px] opacity-30"
        style="background: radial-gradient(circle, rgba(99,102,241,0.3) 0%, transparent 70%); filter:blur(80px);"></div>
      <TypographicManifesto />
    </div>

    {/* Gradient Divider */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 03: Featured Projects */}
    <div class="chapter-reveal stagger-reveal" data-chapter="3"
      style="background: linear-gradient(180deg, #05050f 0%, #020208 100%); position:relative; overflow:hidden;">
      {/* Background orb */}
      <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 w-[600px] h-[600px] opacity-25"
        style="background: radial-gradient(circle, rgba(139,92,246,0.4) 0%, transparent 70%); filter:blur(100px);"></div>

      <section
        id="work"
        aria-label="Featured Engineering Works"
        class="relative py-24 md:py-36 px-6 md:px-12 lg:px-16 contain-layout"
      >
        <div id="projects" class="max-w-[96rem] mx-auto w-full">

          {/* Section Header */}
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
            <div>
              <div class="badge-accent mb-5">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
                Chapter 03 · Featured Engineering Systems
              </div>
              <h2 style="font-size:clamp(2.2rem,1.5rem + 3vw,4rem); font-weight:800; letter-spacing:-0.035em; line-height:1.05; color:#f8fafc;">
                Architecture Built<br/>
                <span style="background: linear-gradient(135deg, #c7d2fe, #818cf8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
                  for Determinism.
                </span>
              </h2>
            </div>
            <a
              href="/projects"
              class="btn-glass inline-flex items-center gap-2 shrink-0"
            >
              <span>View All Works</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <Projects client:load />
        </div>
      </section>
    </div>

    {/* Gradient Divider */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 04: Lab */}
    <div class="chapter-reveal stagger-reveal" data-chapter="4"
      style="background: linear-gradient(180deg, #020208 0%, #03030d 100%); position:relative; overflow:hidden;">
      <div aria-hidden="true" class="pointer-events-none absolute top-1/4 right-0 w-[500px] h-[500px] opacity-20"
        style="background: radial-gradient(circle, rgba(6,182,212,0.4) 0%, transparent 70%); filter:blur(80px);"></div>
      <LabSection />
    </div>

    {/* Gradient Divider */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 05: About */}
    <div class="chapter-reveal stagger-reveal" data-chapter="5"
      style="background: linear-gradient(180deg, #03030d 0%, #050510 100%); position:relative; overflow:hidden;">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-1/3 w-[600px] h-[600px] opacity-20"
        style="background: radial-gradient(circle, rgba(99,102,241,0.35) 0%, transparent 70%); filter:blur(100px);"></div>
      <AboutSection />
    </div>

    {/* Gradient Divider */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 06: Skills */}
    <div class="chapter-reveal stagger-reveal" data-chapter="6"
      style="background: linear-gradient(180deg, #050510 0%, #020208 100%); position:relative; overflow:hidden;">
      <div aria-hidden="true" class="pointer-events-none absolute bottom-0 right-1/4 w-[500px] h-[500px] opacity-20"
        style="background: radial-gradient(circle, rgba(139,92,246,0.3) 0%, transparent 70%); filter:blur(80px);"></div>
      <SkillsSection />
    </div>

    {/* Gradient Divider */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 08: Contact */}
    <div class="chapter-reveal stagger-reveal" data-chapter="8"
      style="background: linear-gradient(180deg, #020208 0%, #030312 100%); position:relative; overflow:hidden;">
      {/* Big glow behind contact */}
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] opacity-30"
        style="background: radial-gradient(ellipse, rgba(99,102,241,0.4) 0%, transparent 70%); filter:blur(80px);"></div>
      <ContactSection />
    </div>
  </div>

  {/* Footer */}
  <Footer slot="footer" />

  {/* Scroll Reveals Observer */}
  <script is:inline>
    (function () {
      function initChapterReveals() {
        var reveals = document.querySelectorAll('.chapter-reveal');
        if (!reveals.length) return;

        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveals.forEach(function (el) { el.classList.add('is-revealed'); });
          return;
        }

        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(
            function (entries, obs) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  obs.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.05 }
          );
          reveals.forEach(function (el) { observer.observe(el); });
        } else {
          reveals.forEach(function (el) { el.classList.add('is-revealed'); });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initChapterReveals);
      } else {
        initChapterReveals();
      }
      document.addEventListener('astro:page-load', initChapterReveals);
    })();
  </script>
</BaseLayout>
