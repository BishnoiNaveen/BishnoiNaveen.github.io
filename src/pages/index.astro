---
/**
 * index.astro - Home page for Naveen Bishnoi Portfolio.
 * Built with Apple visionOS Design System, Fluid Spring Interactions & Multi-Agent Runtimes.
 */
import Layout from '../layouts/Layout.astro';
import HeaderNav from '../components/HeaderNav';
import Hero from '../components/Hero';
import Projects from '../components/Projects';
import About from '../components/About';
import Lab from '../components/Lab';
---

<Layout 
  title="Home" 
  description="Naveen Bishnoi - Developer, AI Automation Engineer & Systems Builder."
>
  <HeaderNav client:load />

  <div class="flex flex-col w-full min-h-screen">
    <Hero client:load />
    
    <Projects client:load />
    
    <About client:load />
    
    <Lab />

    <!-- Contact Section -->
    <section class="w-full py-32 md:py-48 bg-[#09090b] relative overflow-hidden" id="contact">
      {/* Background flare */}
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-full max-w-2xl h-96 bg-blue-500/10 blur-[100px] rounded-full pointer-events-none"></div>
      
      <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
        <h2 class="text-4xl md:text-6xl font-black text-white mb-8 tracking-tight">LET'S BUILD SOMETHING</h2>
        <p class="text-xl md:text-2xl text-zinc-400 font-light mb-16 max-w-2xl mx-auto leading-relaxed">
          Currently open for new opportunities. Whether you have a complex system to build or just want to connect, my inbox is open.
        </p>
        <a href="mailto:0029bishnoinaveen@gmail.com" class="inline-flex items-center justify-center px-10 py-5 text-lg font-bold text-black bg-white rounded-full hover:bg-zinc-200 hover:scale-105 transition-all duration-300">
          Say Hello
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="w-full py-12 bg-[#09090b] border-t border-white/5 relative z-10">
      <div class="max-w-[90rem] mx-auto px-6 md:px-12 flex flex-col md:flex-row justify-between items-center gap-6">
        <p class="text-sm text-zinc-500 font-medium">
          &copy; {new Date().getFullYear()} Naveen Bishnoi. All rights reserved.
        </p>
        <div class="flex gap-8">
          <a href="https://github.com/BishnoiNaveen" target="_blank" rel="noreferrer" class="text-sm font-bold text-zinc-500 hover:text-white transition-colors uppercase tracking-widest">GitHub</a>
          <a href="https://linkedin.com/in/naveen-bishnoi" target="_blank" rel="noreferrer" class="text-sm font-bold text-zinc-500 hover:text-white transition-colors uppercase tracking-widest">LinkedIn</a>
          <a href="https://twitter.com/naveen_bishnoi" target="_blank" rel="noreferrer" class="text-sm font-bold text-zinc-500 hover:text-white transition-colors uppercase tracking-widest">Twitter</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>
