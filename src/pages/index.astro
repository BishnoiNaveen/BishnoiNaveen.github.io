---
/**
 * src/pages/index.astro — Master Systems Architect Portfolio Homepage
 * Author: Naveen Bishnoi
 * Standard: Deep cosmic slate palette, Plus Jakarta Sans typography,
 * zero emojis, multi-tier architecture topology, and gateway portals
 * to dedicated detailed subpages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import Footer from '../components/contact/Footer.astro';
import { bioData } from '../data/bio';
---

<BaseLayout
  title="Naveen Bishnoi · AI Systems & Cloud Backend Engineer"
  description="Systems architecture & engineering portfolio of Naveen Bishnoi — AI Systems & Cloud Backend Engineer at KRONE Agriculture India. Enterprise billing, microservices, and 50Hz telematics."
>
  <FloatingNav client:load slot="header" />

  <main class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-36 pb-24">
    
    {/* HERO SECTION: Minimal, Clean, Rich Colors, Executive Feel */}
    <section class="mb-20 sm:mb-28 text-left">
      {/* Live Availability Badge */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full mb-6 bg-emerald-500/10 border border-emerald-500/25 text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400 select-none shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>[ACTIVE] Available for AI Systems &amp; Cloud Backend Engineering Roles</span>
      </div>

      {/* Main Title & Role */}
      <div class="space-y-3 mb-6">
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-[var(--color-text-primary)] leading-[1.06] font-sans">
          Naveen Bishnoi
        </h1>
        <p class="text-xl sm:text-2xl lg:text-3xl font-bold bg-gradient-to-r from-sky-400 via-indigo-400 to-emerald-400 bg-clip-text text-transparent">
          AI Systems &amp; Cloud Backend Engineer
        </p>
      </div>

      {/* Plain, Simple, High-Rigor Bio */}
      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] font-normal leading-relaxed max-w-2xl mb-8">
        I architect backend microservices, data reconciliation engines, and edge telemetry systems that operate silently and deterministically in production &mdash; currently powering operations at <strong>KRONE Agriculture India</strong> and building verified open-source systems.
      </p>

      {/* Verified Stats Strip — Deep Navy Glass, High Contrast */}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-5 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 shadow-lg mb-10">
        <div>
          <span class="block text-2xl sm:text-3xl font-black text-sky-600 dark:text-sky-400 font-mono">5+ Mos</span>
          <span class="text-xs text-[var(--color-text-muted)] font-medium">KRONE Enterprise Experience</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400 font-mono">326+</span>
          <span class="text-xs text-[var(--color-text-muted)] font-medium">IoT Machinery Telematics</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-black text-indigo-600 dark:text-indigo-400 font-mono">199+</span>
          <span class="text-xs text-[var(--color-text-muted)] font-medium">Fieldy FSM REST APIs</span>
        </div>
        <div>
          <span class="block text-2xl sm:text-3xl font-black text-amber-600 dark:text-amber-400 font-mono">520+</span>
          <span class="text-xs text-[var(--color-text-muted)] font-medium">Python Reconciled Jobs (100% Audit)</span>
        </div>
      </div>

      {/* Action Buttons */}
      <div class="flex flex-wrap items-center gap-3.5">
        <a
          href="/naveen_bishnoi_resume.pdf"
          download="naveen_bishnoi_resume.pdf"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-md shadow-blue-500/25 active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Resume (PDF)</span>
        </a>

        <a
          href="https://www.linkedin.com/in/naveen-bishnoi-b0b00941a/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[#0a66c2] hover:bg-[#084e96] text-white text-sm font-semibold shadow-md shadow-[#0a66c2]/25 active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
          <span>Direct LinkedIn Profile</span>
        </a>

        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-black/[0.04] dark:bg-white/[0.08] hover:bg-black/[0.08] dark:hover:bg-white/[0.12] border border-black/[0.08] dark:border-white/[0.12] text-[var(--color-text-primary)] text-sm font-semibold transition-all active:scale-[0.98] cursor-pointer"
        >
          <span>Get in Touch &rarr;</span>
        </a>
      </div>
    </section>

    {/* SYSTEMS ARCHITECTURE TOPOLOGY: 4-Layer Engineering Overview */}
    <section class="mb-20">
      <div class="pb-3 border-b border-black/[0.08] dark:border-white/10 mb-6 flex items-center justify-between">
        <span class="text-xs font-mono font-bold tracking-wider text-sky-600 dark:text-sky-400 uppercase">
          [SYS-TOPOLOGY] Distributed Stack Architecture
        </span>
        <span class="text-xs font-mono text-[var(--color-text-muted)]">
          KRONE Edge-to-Cloud Runtime
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {/* Tier 1 */}
        <div class="p-5 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 shadow-sm hover:border-sky-500/40 transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400">TIER 01 // EDGE &amp; INTRANET</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-500/10 text-sky-600 dark:text-sky-400 font-semibold">&lt; 30ms latency</span>
          </div>
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-1">Cloudflare Workers &amp; KIN OneHub</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            Edge-routed intranet engine serving corporate employees across India. Instant document distribution via Cloudflare Workers and Supabase storage bucket synchronization.
          </p>
        </div>

        {/* Tier 2 */}
        <div class="p-5 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 shadow-sm hover:border-indigo-500/40 transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400">TIER 02 // MICROSERVICES API</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-semibold">199+ Endpoints</span>
          </div>
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-1">Fieldy FSM &amp; Billing API Gateways</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            RESTful microservice mesh powering Fieldy FSM and enterprise billing (Reliance, Bio Fuel Corp, VERBIO). Strict JWT token guards and automated GST/IGST calculations.
          </p>
        </div>

        {/* Tier 3 */}
        <div class="p-5 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 shadow-sm hover:border-emerald-500/40 transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">TIER 03 // TELEMATICS &amp; INGESTION</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-semibold">50Hz SocketCAN</span>
          </div>
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-1">IoT Machinery Telematics Pipelines</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            Real-time sensor telematics tracking 326+ commercial assets. Circular ring-buffer storage handling offline agricultural environments with automated sync on reconnection.
          </p>
        </div>

        {/* Tier 4 */}
        <div class="p-5 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 shadow-sm hover:border-purple-500/40 transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono font-bold text-purple-600 dark:text-purple-400">TIER 04 // DATA &amp; FORENSIC ENGINE</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-600 dark:text-purple-400 font-semibold">100% Audit Accuracy</span>
          </div>
          <h3 class="text-base font-bold text-[var(--color-text-primary)] mb-1">Python Forensic Analytics &amp; PostgreSQL</h3>
          <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
            34-column pandas &amp; NumPy reporting engine reconciling 520+ service jobs. Multilingual technician note parsing (Hindi/English) into normalized 3NF database schemas.
          </p>
        </div>
      </div>
    </section>

    {/* SECTION PORTALS: Minimal, Clean, Rich Colors, Gateway to Separate Dedicated Webpages */}
    <section class="space-y-6">
      <div class="pb-3 border-b border-black/[0.08] dark:border-white/10 flex items-center justify-between">
        <div>
          <span class="text-xs font-mono font-bold tracking-wider text-sky-600 dark:text-sky-400 uppercase">
            [DIRECTORY] Dedicated Detailed Subsystems
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-[var(--color-text-primary)] tracking-tight mt-1">
            Explore Dedicated Pages
          </h2>
        </div>
        <span class="text-xs font-mono text-[var(--color-text-muted)] hidden sm:block">
          Click any section to load full webpage
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        
        {/* Portal 1: Experience */}
        <a
          href="/experience"
          class="group p-6 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 hover:border-sky-500/40 hover:shadow-xl hover:shadow-sky-500/5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400 uppercase">
                Subsystem 01
              </span>
              <span class="text-xs font-mono text-[var(--color-text-muted)] group-hover:translate-x-1 transition-transform">
                &rarr;
              </span>
            </div>
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] group-hover:text-sky-500 transition-colors mb-2">
              Production Experience
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              Full breakdown of KRONE Agriculture India engineering (Billing, Fieldy FSM, Telematics) and ITTECHXPERT internship.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05] dark:border-white/5 text-[11px] font-mono text-[var(--color-text-muted)]">
            5 Modules &middot; Verified Timeline
          </div>
        </a>

        {/* Portal 2: Projects */}
        <a
          href="/projects"
          class="group p-6 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 hover:border-indigo-500/40 hover:shadow-xl hover:shadow-indigo-500/5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400 uppercase">
                Subsystem 02
              </span>
              <span class="text-xs font-mono text-[var(--color-text-muted)] group-hover:translate-x-1 transition-transform">
                &rarr;
              </span>
            </div>
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] group-hover:text-indigo-500 transition-colors mb-2">
              Featured Projects
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              Smart Task System (Next.js + AI adapters), GAMS (POSIX C99 ERP), AgriBridge India, and KRONE Telematics.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05] dark:border-white/5 text-[11px] font-mono text-[var(--color-text-muted)]">
            Open-Source &middot; GitHub Repositories
          </div>
        </a>

        {/* Portal 3: Skills */}
        <a
          href="/skills"
          class="group p-6 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 hover:border-emerald-500/40 hover:shadow-xl hover:shadow-emerald-500/5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 uppercase">
                Subsystem 03
              </span>
              <span class="text-xs font-mono text-[var(--color-text-muted)] group-hover:translate-x-1 transition-transform">
                &rarr;
              </span>
            </div>
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] group-hover:text-emerald-500 transition-colors mb-2">
              Technical Skills
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              5 core pillars: AI-driven workflows, Python forensic analytics, Cloudflare Workers, PostgreSQL 3NF, and systems programming.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05] dark:border-white/5 text-[11px] font-mono text-[var(--color-text-muted)]">
            5 Pillars &middot; Zero Progress Bars
          </div>
        </a>

        {/* Portal 4: Credentials */}
        <a
          href="/credentials"
          class="group p-6 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 hover:border-amber-500/40 hover:shadow-xl hover:shadow-amber-500/5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400 uppercase">
                Subsystem 04
              </span>
              <span class="text-xs font-mono text-[var(--color-text-muted)] group-hover:translate-x-1 transition-transform">
                &rarr;
              </span>
            </div>
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] group-hover:text-amber-500 transition-colors mb-2">
              Education &amp; Credentials
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              Panjab University BCA (Batch 2026), IBM Python for Data Science (Credly ID), and Deloitte Data Analytics Simulation.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05] dark:border-white/5 text-[11px] font-mono text-[var(--color-text-muted)]">
            Verifiable IDs &middot; Academic Records
          </div>
        </a>

        {/* Portal 5: About */}
        <a
          href="/about"
          class="group p-6 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 hover:border-purple-500/40 hover:shadow-xl hover:shadow-purple-500/5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-purple-600 dark:text-purple-400 uppercase">
                Subsystem 05
              </span>
              <span class="text-xs font-mono text-[var(--color-text-muted)] group-hover:translate-x-1 transition-transform">
                &rarr;
              </span>
            </div>
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] group-hover:text-purple-500 transition-colors mb-2">
              About &amp; Philosophy
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              Engineering mindset, discipline, background from Punjab to Delhi NCR, and principles of radical software honesty.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05] dark:border-white/5 text-[11px] font-mono text-[var(--color-text-muted)]">
            Systems Mindset &middot; Background
          </div>
        </a>

        {/* Portal 6: Digital Resume */}
        <a
          href="/resume"
          class="group p-6 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 hover:border-blue-500/40 hover:shadow-xl hover:shadow-blue-500/5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-blue-600 dark:text-blue-400 uppercase">
                Subsystem 06
              </span>
              <span class="text-xs font-mono text-[var(--color-text-muted)] group-hover:translate-x-1 transition-transform">
                &rarr;
              </span>
            </div>
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] group-hover:text-blue-500 transition-colors mb-2">
              ATS-Unrejectable Resume
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              Interactive clean web curriculum vitae with 1-click verified download as naveen_bishnoi_resume.pdf.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05] dark:border-white/5 text-[11px] font-mono text-[var(--color-text-muted)]">
            1-Click PDF Download
          </div>
        </a>

        {/* Portal 7: Security Policy */}
        <a
          href="/security"
          class="group p-6 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 hover:border-emerald-500/40 hover:shadow-xl hover:shadow-emerald-500/5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 uppercase">
                Subsystem 07
              </span>
              <span class="text-xs font-mono text-[var(--color-text-muted)] group-hover:translate-x-1 transition-transform">
                &rarr;
              </span>
            </div>
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] group-hover:text-emerald-500 transition-colors mb-2">
              Security &amp; Compliance
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              DPDP 2023 / GDPR compliance, zero-telemetry policy, ISO/IEC 27001 principles, and responsible vulnerability disclosure.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05] dark:border-white/5 text-[11px] font-mono text-[var(--color-text-muted)]">
            ISO 27001 &middot; Zero Telemetry
          </div>
        </a>

        {/* Portal 8: Terms & Licensing */}
        <a
          href="/terms"
          class="group p-6 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 hover:border-sky-500/40 hover:shadow-xl hover:shadow-sky-500/5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400 uppercase">
                Subsystem 08
              </span>
              <span class="text-xs font-mono text-[var(--color-text-muted)] group-hover:translate-x-1 transition-transform">
                &rarr;
              </span>
            </div>
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] group-hover:text-sky-500 transition-colors mb-2">
              Terms &amp; Open Knowledge
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              Open source MIT licensing, Creative Commons CC BY-SA 4.0 attribution, and fair use guidelines.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05] dark:border-white/5 text-[11px] font-mono text-[var(--color-text-muted)]">
            MIT License &middot; CC BY-SA 4.0
          </div>
        </a>

        {/* Portal 9: Contact */}
        <a
          href="/contact"
          class="group p-6 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 hover:border-rose-500/40 hover:shadow-xl hover:shadow-rose-500/5 transition-all duration-300 flex flex-col justify-between cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono font-bold text-rose-600 dark:text-rose-400 uppercase">
                Subsystem 09
              </span>
              <span class="text-xs font-mono text-[var(--color-text-muted)] group-hover:translate-x-1 transition-transform">
                &rarr;
              </span>
            </div>
            <h3 class="text-lg font-bold text-[var(--color-text-primary)] group-hover:text-rose-500 transition-colors mb-2">
              Direct Contact
            </h3>
            <p class="text-xs text-[var(--color-text-secondary)] leading-relaxed">
              Copy verified email, initiate telephone inquiry, or connect directly on LinkedIn.
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-black/[0.05] dark:border-white/5 text-[11px] font-mono text-[var(--color-text-muted)]">
            24h Response SLA &middot; Direct Bridge
          </div>
        </a>

      </div>
    </section>

    {/* DIRECT LINKEDIN PUBLIC ACCESS CARD */}
    <section class="mt-16 p-6 sm:p-8 rounded-2xl bg-white/70 dark:bg-[#0c111e]/80 border border-black/[0.08] dark:border-white/10 shadow-lg">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-1.5">
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-mono font-bold">
