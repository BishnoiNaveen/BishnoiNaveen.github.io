---
/**
 * src/pages/index.astro — Master Storytelling Page: 8-Chapter Cinematic Scroll-Typography
 * Chapter 01: Cinematic Editorial Hero (#hero)
 * Chapter 02: Typographic Manifesto & Systems Invariants (#manifesto)
 * Chapter 03: Featured Engineering Works (#work, #projects)
 * Chapter 04: The Systems Lab & Interactive Simulators (#lab, #workflows, #hermes)
 * Chapter 05: Editorial Narrative & Principles (#about)
 * Chapter 06: Technical Competencies Bento Grid (#skills)
 * Chapter 07: Verified Career & Academic Timeline (#timeline)
 * Chapter 08: Direct Communication & Verified Signature (#contact)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import CinematicExperience from '../experience/CinematicExperience';
import CinematicHero from '../components/hero/CinematicHero.astro';
import TypographicManifesto from '../components/manifesto/TypographicManifesto.astro';
import Projects from '../components/Projects';
import LabSection from '../components/lab/LabSection.astro';
import AboutSection from '../components/about/AboutSection.astro';
import SkillsSection from '../components/about/SkillsSection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import Footer from '../components/contact/Footer.astro';
---

<BaseLayout
  title="Naveen Bishnoi | Software Architect & AI Systems Engineer"
  description="Personal Brand & Systems Architecture Showcase of Naveen Bishnoi — Software Architect, AI Automation Engineer, and Systems Builder at KRONE Agriculture India."
>
  {/* Floating Navigation Dock (Level 3 visionOS Glass) */}
  <FloatingNav slot="header" />

  {/* CINEMATIC SCROLL-DRIVEN 3D JOURNEY — 7 continuous scenes (BOOT → PORTFOLIO) */}
  <CinematicExperience client:only="react" scrollTrackHeight="700vh" />

  <div class="relative w-full overflow-hidden bg-[var(--color-canvas)] text-[var(--color-text-primary)]">
    {/* CHAPTER 01: CINEMATIC EDITORIAL HERO */}
    <div class="chapter-reveal is-revealed" data-chapter="1">
      <CinematicHero />
    </div>

    {/* CHAPTER 02: TYPOGRAPHIC MANIFESTO */}
    <div class="chapter-reveal" data-chapter="2">
      <TypographicManifesto />
    </div>

    {/* CHAPTER 03: FEATURED ENGINEERING WORKS */}
    <div class="chapter-reveal" data-chapter="3">
      <section
        id="work"
        aria-label="Featured Engineering Works"
        class="relative py-24 md:py-36 px-4 sm:px-6 md:px-12 lg:px-16 border-t border-[var(--color-border-subtle)] contain-layout"
      >
        <div id="projects" class="max-w-[96rem] mx-auto w-full">
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
            <div>
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/[0.04] dark:bg-white/[0.06] border border-[var(--color-border)] mb-4 select-none">
                <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
                <span class="type-badge-label text-[var(--color-text-secondary)] text-[11px] font-semibold tracking-[0.08em] uppercase">
                  Chapter 03 · Featured Engineering Systems
                </span>
              </div>
              <h2 class="type-headline-chapter text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-[-0.035em] text-[var(--color-text-primary)]">
                Architecture Built for Determinism.
              </h2>
            </div>
            <a
              href="/projects"
              class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-accent)] hover:underline"
            >
              <span>View All Engineering Works</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                <path strokeLinecap="round" strokeLinejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <Projects client:load />
        </div>
      </section>
    </div>

    {/* CHAPTER 04: THE SYSTEMS LAB (INTERACTIVE EXPERIMENTAL SUITE) */}
    <div class="chapter-reveal" data-chapter="4">
      <LabSection />
    </div>

    {/* CHAPTER 05 & 07: EDITORIAL ABOUT NARRATIVE & 3-TIER TIMELINE */}
    <div class="chapter-reveal" data-chapter="5">
      <AboutSection />
    </div>

    {/* CHAPTER 06: TECHNICAL COMPETENCIES BENTO GRID */}
    <div class="chapter-reveal" data-chapter="6">
      <SkillsSection />
    </div>

    {/* CHAPTER 08: DIRECT COMMUNICATION & VERIFIED SIGNATURE */}
    <div class="chapter-reveal" data-chapter="8">
      <ContactSection />
    </div>
  </div>

  {/* MINIMALIST SYSTEM FOOTER */}
  <Footer slot="footer" />

  {/* Scroll Storytelling & Chapter Reveal Observer (Apple WWDC 2018 Fluid Physics) */}
  <script is:inline>
    (function () {
      function initChapterReveals() {
        var reveals = document.querySelectorAll('.chapter-reveal');
        if (!reveals.length) return;

        // If reduced motion is requested, immediately reveal all chapters without animation
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveals.forEach(function (el) {
            el.classList.add('is-revealed');
          });
          return;
        }

        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(
            function (entries, obs) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  obs.unobserve(entry.target);
                }
              });
            },
            {
              rootMargin: '0px 0px -8% 0px',
              threshold: 0.08,
            }
          );

          reveals.forEach(function (el) {
            observer.observe(el);
          });
        } else {
          // Fallback for older browsers
          reveals.forEach(function (el) {
            el.classList.add('is-revealed');
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initChapterReveals);
      } else {
        initChapterReveals();
      }

      document.addEventListener('astro:page-load', initChapterReveals);
    })();
  </script>
</BaseLayout>
