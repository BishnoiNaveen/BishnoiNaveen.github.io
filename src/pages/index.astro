---
/**
 * index.astro — Naveen Bishnoi Portfolio
 * World-Class Systems Engineering Landing Page
 * Inspired by Apple, Linear & Bishnoi Gas Services UI Fluidity
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import AmbientAtmosphere from '../components/ui/AmbientAtmosphere';
import FloatingNav from '../components/nav/FloatingNav';
import CleanHero from '../components/hero/CleanHero.astro';
import CleanProjects from '../components/projects/CleanProjects.astro';
import InteractivePlayground from '../components/toys/InteractivePlayground';
import CleanExperience from '../components/experience/CleanExperience.astro';
import CleanSkills from '../components/about/CleanSkills.astro';
import CleanContact from '../components/contact/CleanContact.astro';
import KeyboardHintBanner from '../components/ui/KeyboardHintBanner';
import Footer from '../components/contact/Footer.astro';
---

<BaseLayout
  title="Naveen Bishnoi · Software Architect & Systems Engineer"
  description="Personal engineering portfolio of Naveen Bishnoi — Software Architect & Systems Engineer at KRONE Agriculture India. Edge telematics, distributed systems, POSIX engines, and cloud infrastructure."
>
  {/* Ambient Dynamic Background & Starfield Particles */}
  <AmbientAtmosphere client:load />

  {/* Floating Navigation */}
  <FloatingNav slot="header" client:load />

  {/* Main Landing Page Content Container */}
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    {/* Hero Section with Split Cockpit */}
    <CleanHero />

    {/* Subtle Section Divider */}
    <hr class="border-black/[0.06] dark:border-white/[0.08]" />

    {/* Featured Projects Bento */}
    <CleanProjects />

    {/* Subtle Section Divider */}
    <hr class="border-black/[0.06] dark:border-white/[0.08]" />

    {/* Interactive Systems Lab & Toys Playground */}
    <InteractivePlayground client:visible />

    {/* Subtle Section Divider */}
    <hr class="border-black/[0.06] dark:border-white/[0.08]" />

    {/* Work Experience Timeline */}
    <CleanExperience />

    {/* Subtle Section Divider */}
    <hr class="border-black/[0.06] dark:border-white/[0.08]" />

    {/* Technical Skills Bento */}
    <CleanSkills />

    {/* Subtle Section Divider */}
    <hr class="border-black/[0.06] dark:border-white/[0.08]" />

    {/* Contact & CTA Section */}
    <CleanContact />
  </div>

  {/* Floating Keyboard Shortcut & Acoustic Feedback Hint Banner */}
  <KeyboardHintBanner client:load />

  {/* Clean Footer */}
  <Footer slot="footer" />
</BaseLayout>
