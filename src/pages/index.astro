---
/**
 * index.astro — Apple VisionOS Luminous Portfolio
 * 8 Chapters · Natural High-Speed Smooth Scroll · Translucent Liquid Glass · AI Toys & Copilot
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import CinematicHero from '../components/hero/CinematicHero.astro';
import TypographicManifesto from '../components/manifesto/TypographicManifesto.astro';
import Projects from '../components/Projects';
import InteractivePlayground from '../components/toys/InteractivePlayground';
import LabSection from '../components/lab/LabSection.astro';
import AboutSection from '../components/about/AboutSection.astro';
import SkillsSection from '../components/about/SkillsSection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import Footer from '../components/contact/Footer.astro';
import NaveenAssistant from '../components/ai/NaveenAssistant';
---

<BaseLayout
  title="Naveen Bishnoi | Software Architect & AI Systems Engineer"
  description="Personal Brand & Systems Architecture Showcase of Naveen Bishnoi — Software Architect, AI Automation Engineer, and Systems Builder at KRONE Agriculture India."
>
  {/* Floating Navigation Bar */}
  <FloatingNav slot="header" client:load />

  {/* ── ALL EDITORIAL CHAPTERS — Apple VisionOS Ceramic Luminous Aesthetic ── */}
  <div class="relative w-full overflow-hidden bg-[var(--color-canvas)] text-[var(--color-text-primary)]">

    {/* Chapter 01: Hero (Interactive Monogram & Identity Hub) */}
    <div class="chapter-reveal is-revealed" data-chapter="1">
      <CinematicHero />
    </div>

    {/* Section Divider Hairline */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 02: Typographic Manifesto */}
    <div class="chapter-reveal stagger-reveal relative" data-chapter="2">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 right-0 w-[500px] h-[500px] opacity-25"
        style="background: radial-gradient(circle, rgba(0,113,227,0.12) 0%, transparent 70%); filter:blur(80px);"></div>
      <TypographicManifesto />
    </div>

    {/* Section Divider Hairline */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 03: Featured Engineering Systems */}
    <div class="chapter-reveal stagger-reveal relative overflow-hidden" data-chapter="3">
      <div aria-hidden="true" class="pointer-events-none absolute bottom-0 left-0 w-[600px] h-[600px] opacity-20"
        style="background: radial-gradient(circle, rgba(128,32,232,0.1) 0%, transparent 70%); filter:blur(90px);"></div>

      <section
        id="work"
        aria-label="Featured Engineering Works"
        class="relative py-20 md:py-32 px-6 md:px-12 lg:px-16 contain-layout"
      >
        <div id="projects" class="max-w-[96rem] mx-auto w-full">

          {/* Section Header */}
          <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
            <div>
              <div class="badge-accent mb-4">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
                Chapter 03 · Featured Engineering Systems
              </div>
              <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-[-0.035em] text-[var(--color-text-primary)] leading-[1.05]">
                Architecture Built<br/>
                <span class="bg-gradient-to-r from-[var(--color-accent)] to-purple-600 bg-clip-text text-transparent">
                  for Determinism.
                </span>
              </h2>
            </div>
            <a
              href="/projects"
              class="btn-glass inline-flex items-center gap-2 shrink-0"
            >
              <span>View All Works</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>

          <Projects client:load />
        </div>
      </section>
    </div>

    {/* Section Divider Hairline */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 04: Interactive Systems Toys (Playground) */}
    <div class="chapter-reveal stagger-reveal relative overflow-hidden" data-chapter="4">
      <InteractivePlayground client:load />
    </div>

    {/* Section Divider Hairline */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 05: Engineering Lab Suite */}
    <div class="chapter-reveal stagger-reveal relative overflow-hidden" data-chapter="5">
      <div aria-hidden="true" class="pointer-events-none absolute top-1/4 right-0 w-[500px] h-[500px] opacity-15"
        style="background: radial-gradient(circle, rgba(2,132,199,0.15) 0%, transparent 70%); filter:blur(80px);"></div>
      <LabSection />
    </div>

    {/* Section Divider Hairline */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 06: About & Axioms */}
    <div class="chapter-reveal stagger-reveal relative overflow-hidden" data-chapter="6">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-1/3 w-[600px] h-[600px] opacity-15"
        style="background: radial-gradient(circle, rgba(0,113,227,0.12) 0%, transparent 70%); filter:blur(90px);"></div>
      <AboutSection />
    </div>

    {/* Section Divider Hairline */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 07: Technical Competencies Bento */}
    <div class="chapter-reveal stagger-reveal relative overflow-hidden" data-chapter="7">
      <div aria-hidden="true" class="pointer-events-none absolute bottom-0 right-1/4 w-[500px] h-[500px] opacity-15"
        style="background: radial-gradient(circle, rgba(128,32,232,0.12) 0%, transparent 70%); filter:blur(80px);"></div>
      <SkillsSection />
    </div>

    {/* Section Divider Hairline */}
    <div class="divider-gradient w-full"></div>

    {/* Chapter 08: Direct Contact & Signature */}
    <div class="chapter-reveal stagger-reveal relative overflow-hidden" data-chapter="8">
      <div aria-hidden="true" class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] opacity-20"
        style="background: radial-gradient(ellipse, rgba(0,113,227,0.15) 0%, transparent 70%); filter:blur(90px);"></div>
      <ContactSection />
    </div>
  </div>

  {/* Floating Naveen AI Copilot Widget */}
  <NaveenAssistant client:load />

  {/* Footer */}
  <Footer slot="footer" />

  {/* Scroll Reveals Observer */}
  <script is:inline>
    (function () {
      function initChapterReveals() {
        var reveals = document.querySelectorAll('.chapter-reveal');
        if (!reveals.length) return;

        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveals.forEach(function (el) { el.classList.add('is-revealed'); });
          return;
        }

        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(
            function (entries, obs) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  obs.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.05 }
          );
          reveals.forEach(function (el) { observer.observe(el); });
        } else {
          reveals.forEach(function (el) { el.classList.add('is-revealed'); });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initChapterReveals);
      } else {
        initChapterReveals();
      }
      document.addEventListener('astro:page-load', initChapterReveals);
    })();
  </script>
</BaseLayout>
