---
/**
 * src/pages/projects.astro — World-Class Systems Gallery
 * Showcases all production projects with rich photography, metrics, and case studies.
 * Author: Naveen Bishnoi
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import Footer from '../components/contact/Footer.astro';
import { projects } from '../data/projects';
---

<BaseLayout
  title="Real-World Projects · Naveen Bishnoi"
  description="Comprehensive real-world engineering projects by Naveen Bishnoi: Smart Task System (Next.js & AI APIs), GAMS (C99 & MySQL ERP), AgriBridge India, and KRONE Telematics."
>
  <FloatingNav client:load slot="header" />

  <main class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-36 pb-24">
    {/* Page Header */}
    <div class="mb-14 sm:mb-16 pb-8 border-b border-black/[0.08] dark:border-white/10">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full mb-4 bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800 text-xs font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300 select-none">
        <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
        05 &middot; Real-World Engineering Projects
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[var(--color-text-primary)] mb-4">
        Real Systems. Real Repositories.
      </h1>
      <p class="text-base sm:text-lg text-[var(--color-text-secondary)] max-w-2xl leading-relaxed">
        From full-stack Next.js web applications with dual AI fallbacks to high-performance C99 ERP engines and 50Hz machine telematics.
      </p>
    </div>

    {/* Projects Visual Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {projects.map((project) => (
        <article class="group flex flex-col justify-between rounded-3xl overflow-hidden bg-white/80 dark:bg-[#0c101d]/85 backdrop-blur-xl border border-black/[0.08] dark:border-white/10 shadow-[0_8px_32px_rgba(0,0,0,0.04)] dark:shadow-[0_16px_48px_rgba(0,0,0,0.5)] hover:border-blue-500/40 hover:-translate-y-1.5 transition-all duration-300">
          <div>
            {/* Visual Image Header */}
            <div class="relative w-full h-48 sm:h-52 overflow-hidden bg-slate-950">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
                onerror="this.src='/images/krone-telematics.jpg'"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none" />

              {/* Domain & Status Pills */}
              <div class="absolute top-3 inset-x-3 flex items-center justify-between gap-2 pointer-events-none">
                <span class="px-2.5 py-1 rounded-full bg-black/65 backdrop-blur-md border border-white/20 text-white text-[10px] font-mono font-medium tracking-wide">
                  {project.category}
                </span>
                <span class="px-2 py-0.5 rounded-full bg-black/65 backdrop-blur-md border border-white/20 text-emerald-400 text-[10px] font-mono font-medium flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  {project.status === 'live' ? 'Live System' : 'Verified'}
                </span>
              </div>
            </div>

            {/* Content Area */}
            <div class="p-6 sm:p-7">
              <h2 class="text-xl font-extrabold tracking-tight text-[var(--color-text-primary)] group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-1.5">
                {project.title}
              </h2>
              <p class="text-xs text-blue-600 dark:text-blue-400 font-mono font-semibold mb-3">
                {project.subtitle}
              </p>
              <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed mb-5 font-normal">
                {project.description}
              </p>

              {/* Highlights */}
              <ul class="space-y-1.5 mb-6">
                {project.highlights.slice(0, 2).map((highlight) => (
                  <li class="flex items-start gap-2 text-xs text-[var(--color-text-secondary)]">
                    <svg class="w-3.5 h-3.5 text-emerald-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          {/* Card Footer: Tech Tags & Links */}
          <div class="px-6 sm:px-7 pb-6 pt-4 border-t border-black/[0.06] dark:border-white/[0.08] flex flex-col gap-4">
            <div class="flex flex-wrap gap-1.5">
              {project.techStack.slice(0, 4).map((tech) => (
                <span class="px-2 py-0.5 rounded-md bg-black/[0.04] dark:bg-white/[0.06] border border-black/[0.05] dark:border-white/10 text-[10px] font-mono text-neutral-700 dark:text-neutral-300 font-semibold">
                  {tech}
                </span>
              ))}
              {project.techStack.length > 4 && (
                <span class="px-1.5 py-0.5 text-[10px] font-mono text-neutral-500 dark:text-neutral-400 font-semibold">
                  +{project.techStack.length - 4}
                </span>
              )}
            </div>

            <div class="flex items-center justify-between gap-3 pt-2">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                  </svg>
                  <span>GitHub Repository &rarr;</span>
                </a>
              )}

              {project.live && (
                <a
                  href={project.live}
                  class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
                >
                  <span>Case Study</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* Section Footer */}
    <section class="mt-16 p-8 rounded-3xl bg-gradient-to-br from-blue-500/10 via-emerald-500/5 to-purple-500/10 border border-blue-500/20 text-center flex flex-col items-center">
      <h3 class="text-2xl font-bold text-[var(--color-text-primary)] mb-2">Want to see the full code or discuss an architecture?</h3>
      <p class="text-sm sm:text-base text-[var(--color-text-secondary)] max-w-xl mb-6">
        Download my verified resume as naveen_bishnoi_resume.pdf or reach out directly for technical discussions.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/naveen_bishnoi_resume.pdf"
          download="naveen_bishnoi_resume.pdf"
          class="px-6 py-3 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all"
        >
          Download naveen_bishnoi_resume.pdf &darr;
        </a>
        <a
          href="/contact"
          class="px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-sm transition-all"
        >
          Contact Naveen &rarr;
        </a>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>
