---
/**
 * src/pages/credentials.astro — Dedicated Education & Verified Certifications Page
 * Real-world academic background, verified IDs, and industry certifications of Naveen Bishnoi
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import Footer from '../components/contact/Footer.astro';
---

<BaseLayout
  title="Education & Verified Credentials · Naveen Bishnoi"
  description="Verified academic credentials and industry certifications of Naveen Bishnoi — Panjab University BCA, IBM Python for Data Science, and Deloitte Forensic Data Analytics."
>
  <FloatingNav client:load slot="header" />

  <main class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 sm:pt-36 pb-24">
    {/* Page Header */}
    <div class="mb-14 sm:mb-20 pb-8 border-b border-black/[0.08] dark:border-white/10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-300 text-xs font-semibold tracking-wide uppercase mb-4">
        <span>04 &middot; Education &amp; Certifications</span>
      </div>
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[var(--color-text-primary)] leading-[1.1] mb-6">
        Verified Academic &amp; Industry Credentials.
      </h1>
      <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] font-normal leading-relaxed max-w-3xl">
        Transparent, verified credentials with official validation IDs and academic performance records.
      </p>
    </div>

    <div class="space-y-16">
      {/* Industry Certifications */}
      <section>
        <div class="mb-8">
          <span class="text-xs font-mono font-bold tracking-wider text-blue-600 dark:text-blue-400 uppercase block mb-1">
            Industry Validations
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text-primary)]">
            Professional Certifications &amp; Simulations
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {/* IBM Python */}
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300">
                  IBM Certified
                </span>
                <span class="text-xs text-[var(--color-text-muted)] font-mono">Issued: September 2026</span>
              </div>
              <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-2">Python for Data Science</h3>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">
                Demonstrated industry proficiency in Python programming, data structures, data analysis libraries (pandas, NumPy), and data science fundamentals.
              </p>
            </div>

            <div class="pt-4 border-t border-black/[0.06] dark:border-white/[0.08] space-y-2">
              <div class="text-xs font-mono text-[var(--color-text-muted)]">
                <span class="font-semibold text-[var(--color-text-primary)]">Credly Badge ID:</span>
                <code class="block text-[11px] text-blue-600 dark:text-blue-400 mt-0.5 break-all">ea12611d-75c0-4282-8bf5-baaf48aa0cca</code>
              </div>
              <a
                href="https://www.credly.com/badges/ea12611d-75c0-4282-8bf5-baaf48aa0cca"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline pt-1"
              >
                <span>Verify on Credly &rarr;</span>
              </a>
            </div>
          </div>

          {/* Deloitte */}
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300">
                  Deloitte (Forage)
                </span>
                <span class="text-xs text-[var(--color-text-muted)] font-mono">Issued: July 2026</span>
              </div>
              <h3 class="text-xl font-bold text-[var(--color-text-primary)] mb-2">Data Analytics Job Simulation</h3>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">
                Completed practical industry simulation in Data Analysis and Forensic Technology, evaluating enterprise business records, ledger anomalies, and telemetry data.
              </p>
            </div>

            <div class="pt-4 border-t border-black/[0.06] dark:border-white/[0.08] space-y-1.5 text-xs font-mono text-[var(--color-text-muted)]">
              <div>
                <span class="font-semibold text-[var(--color-text-primary)]">Enrolment Code:</span>
                <code class="text-[11px] text-emerald-600 dark:text-emerald-400 ml-1">wMeKLdvmcywB24F9m</code>
              </div>
              <div>
                <span class="font-semibold text-[var(--color-text-primary)]">User Code:</span>
                <code class="text-[11px] text-emerald-600 dark:text-emerald-400 ml-1">68b9914a675caa305d2244be</code>
              </div>
            </div>
          </div>

          {/* ITTECHXPERT Internship Certification */}
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 shadow-sm md:col-span-2 flex flex-col justify-between">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
              <div>
                <span class="text-xs font-mono font-bold px-2.5 py-0.5 rounded-full bg-purple-100 dark:bg-purple-950/80 text-purple-700 dark:text-purple-300">
                  Industrial Development Internship
                </span>
                <h3 class="text-xl font-bold text-[var(--color-text-primary)] mt-2">Software &amp; Web Development Certification</h3>
              </div>
              <span class="text-xs text-[var(--color-text-muted)] font-mono">Issued: August 2025 &middot; ITTECHXPERT</span>
            </div>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-4">
              Completed hands-on enterprise software development in Java, PHP, MySQL, HTML5/CSS3, and modern AI development tooling (Cursor, ChatGPT, Claude) with an evaluation grade of <strong>Excellent</strong>.
            </p>
          </div>
        </div>
      </section>

      {/* Academic Qualifications */}
      <section>
        <div class="mb-8">
          <span class="text-xs font-mono font-bold tracking-wider text-purple-600 dark:text-purple-400 uppercase block mb-1">
            Formal Education
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text-primary)]">
            Academic Trajectory &amp; Degrees
          </h2>
        </div>

        <div class="space-y-4">
          {/* Degree 1 */}
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
              <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text-primary)]">
                Bachelor of Computer Applications (BCA) &mdash; Final Year (Batch 2026)
              </h3>
              <span class="text-xs font-mono font-semibold px-2.5 py-0.5 rounded-full bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300 w-fit">
                2023 &mdash; 2026
              </span>
            </div>
            <p class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-4">
              DAV College Abohar (Panjab University, Chandigarh) &middot; Punjab, India
            </p>
            <div class="pt-3 border-t border-black/[0.06] dark:border-white/[0.08]">
              <strong class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)] font-mono block mb-2">
                Relevant Core Coursework:
              </strong>
              <div class="flex flex-wrap gap-2">
                {['Database Management Systems (DBMS)', 'Advanced SQL Querying', 'Data Structures & Algorithms', 'Python Programming', 'Computer Networks', 'Operating Systems', 'Artificial Intelligence Fundamentals'].map((course) => (
                  <span class="text-xs font-mono px-2.5 py-1 rounded-lg bg-black/[0.03] dark:bg-white/[0.06] text-[var(--color-text-secondary)]">
                    {course}
                  </span>
                ))}
              </div>
            </div>
          </div>

          {/* School 1 */}
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-base sm:text-lg font-bold text-[var(--color-text-primary)]">
                Senior Secondary Education (Class XII) &mdash; PSEB
              </h3>
              <p class="text-xs sm:text-sm text-[var(--color-text-muted)]">
                Maya Devi Memorial Aadarsh School, Punjab &middot; 2021 &mdash; 2023
              </p>
            </div>
            <div class="text-left sm:text-right">
              <span class="text-xl sm:text-2xl font-black text-emerald-600 dark:text-emerald-400 font-mono">81%</span>
              <span class="block text-[11px] text-[var(--color-text-muted)]">Final Examination Score</span>
            </div>
          </div>

          {/* School 2 */}
          <div class="p-6 rounded-3xl bg-white/70 dark:bg-white/[0.03] border border-black/[0.08] dark:border-white/10 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h3 class="text-base sm:text-lg font-bold text-[var(--color-text-primary)]">
                Secondary School Certificate (Class X) &mdash; PSEB
              </h3>
              <p class="text-xs sm:text-sm text-[var(--color-text-muted)]">
                Maya Devi Memorial Aadarsh School, Punjab &middot; 2019 &mdash; 2021
              </p>
            </div>
            <div class="text-left sm:text-right">
              <span class="text-xl sm:text-2xl font-black text-purple-600 dark:text-purple-400 font-mono">93% (Distinction)</span>
              <span class="block text-[11px] text-[var(--color-text-muted)]">State Board Distinction</span>
            </div>
          </div>
        </div>
      </section>

      {/* Navigation Footer */}
      <section class="mt-16 p-8 rounded-3xl bg-gradient-to-br from-cyan-500/10 via-blue-500/5 to-emerald-500/10 border border-cyan-500/20 text-center flex flex-col items-center">
        <h3 class="text-2xl font-bold text-[var(--color-text-primary)] mb-2">Ready to download the complete resume?</h3>
        <p class="text-sm sm:text-base text-[var(--color-text-secondary)] max-w-xl mb-6">
          Download the verified ATS-optimized PDF resume directly to inspect full details offline.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3">
          <a
            href="/naveen_bishnoi_resume.pdf"
            download="naveen_bishnoi_resume.pdf"
            class="px-6 py-3 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold shadow-sm transition-all"
          >
            Download naveen_bishnoi_resume.pdf &darr;
          </a>
          <a
            href="/resume"
            class="px-6 py-3 rounded-full bg-black/[0.05] dark:bg-white/[0.08] hover:bg-black/[0.1] text-[var(--color-text-primary)] border border-black/[0.08] dark:border-white/10 text-sm font-semibold transition-all"
          >
            View Online Resume &rarr;
          </a>
          <a
            href="/contact"
            class="px-6 py-3 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all"
          >
            Contact Naveen &rarr;
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
