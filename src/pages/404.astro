---
/**
 * src/pages/404.astro — Master Systems 404 Route Recovery Page
 * Author: Naveen Bishnoi
 * Standard: Deep cosmic palette, instant subsystem recovery grid, zero emojis
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloatingNav from '../components/nav/FloatingNav';
import Footer from '../components/contact/Footer.astro';
---

<BaseLayout
  title="404 — Subsystem Route Not Found | Naveen Bishnoi"
  description="The requested route does not exist in Naveen Bishnoi's systems architecture portfolio. Select a verified subsystem to navigate."
  noindex={true}
>
  <FloatingNav slot="header" client:load />

  <main class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 min-h-[80vh] flex flex-col justify-center items-center py-24 sm:py-32">
    
    {/* Diagnostic Container */}
    <div class="w-full p-8 sm:p-12 rounded-3xl bg-white/80 dark:bg-[#0c111e]/90 backdrop-blur-2xl border border-black/[0.08] dark:border-white/10 shadow-2xl text-center">
      
      {/* Diagnostic Badge */}
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-xs font-mono font-bold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
        HTTP Status 404 // Route Resolution Fault
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-[var(--color-text-primary)] mb-4 font-sans">
        Subsystem Not Located
      </h1>

      <p class="text-base sm:text-lg text-[var(--color-text-secondary)] max-w-xl mx-auto mb-8 leading-relaxed font-normal">
        The requested path could not be resolved by the edge routing layer. Please select one of the verified subsystem nodes below to continue.
      </p>

      {/* Primary Action Button */}
      <div class="mb-10">
        <a
          href="/"
          class="px-8 py-4 rounded-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold tracking-tight shadow-lg shadow-blue-500/25 inline-flex items-center gap-2 transition-all active:scale-[0.98] cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Return to Command Center (Home)
        </a>
      </div>

      {/* Subsystem Quick Recovery Grid */}
      <div class="text-left mb-8">
        <span class="block text-xs font-mono font-bold text-[var(--color-text-muted)] uppercase tracking-wider mb-3">
          Available System Nodes
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <a
            href="/experience"
            class="p-3 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.06] dark:border-white/10 hover:border-blue-500/40 hover:bg-blue-500/5 transition-all text-xs font-semibold text-[var(--color-text-primary)] flex items-center justify-between"
          >
            <span>Experience</span>
            <span class="font-mono text-[var(--color-text-muted)]">&rarr;</span>
          </a>

          <a
            href="/projects"
            class="p-3 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.06] dark:border-white/10 hover:border-blue-500/40 hover:bg-blue-500/5 transition-all text-xs font-semibold text-[var(--color-text-primary)] flex items-center justify-between"
          >
            <span>Projects</span>
            <span class="font-mono text-[var(--color-text-muted)]">&rarr;</span>
          </a>

          <a
            href="/skills"
            class="p-3 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.06] dark:border-white/10 hover:border-blue-500/40 hover:bg-blue-500/5 transition-all text-xs font-semibold text-[var(--color-text-primary)] flex items-center justify-between"
          >
            <span>Skills</span>
            <span class="font-mono text-[var(--color-text-muted)]">&rarr;</span>
          </a>

          <a
            href="/credentials"
            class="p-3 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.06] dark:border-white/10 hover:border-blue-500/40 hover:bg-blue-500/5 transition-all text-xs font-semibold text-[var(--color-text-primary)] flex items-center justify-between"
          >
            <span>Credentials</span>
            <span class="font-mono text-[var(--color-text-muted)]">&rarr;</span>
          </a>

          <a
            href="/resume"
            class="p-3 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.06] dark:border-white/10 hover:border-blue-500/40 hover:bg-blue-500/5 transition-all text-xs font-semibold text-[var(--color-text-primary)] flex items-center justify-between"
          >
            <span>Digital Resume</span>
            <span class="font-mono text-[var(--color-text-muted)]">&rarr;</span>
          </a>

          <a
            href="/contact"
            class="p-3 rounded-xl bg-black/[0.03] dark:bg-white/[0.04] border border-black/[0.06] dark:border-white/10 hover:border-blue-500/40 hover:bg-blue-500/5 transition-all text-xs font-semibold text-[var(--color-text-primary)] flex items-center justify-between"
          >
            <span>Contact</span>
            <span class="font-mono text-[var(--color-text-muted)]">&rarr;</span>
          </a>
        </div>
      </div>

      {/* Terminal Diagnostic Block */}
      <div class="p-4 rounded-xl bg-black/[0.04] dark:bg-black/50 border border-black/[0.06] dark:border-white/5 text-left font-mono text-xs text-[var(--color-text-secondary)] overflow-x-auto max-w-lg mx-auto">
        <div class="text-neutral-500 mb-1">$ curl -I https://bishnoinaveen.github.io{Astro.url.pathname}</div>
        <div class="text-rose-600 dark:text-rose-400 font-semibold">HTTP/2 404 Not Found</div>
        <div class="text-neutral-400">server: Cloudflare Edge / GitHub Pages CDN</div>
        <div class="text-neutral-400">cluster-state: HEALTHY [Nodes: 11 Active]</div>
        <div class="text-neutral-400">recovery-action: Redirect to Root (/)</div>
      </div>

    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
