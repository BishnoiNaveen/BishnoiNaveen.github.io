---
/**
 * HeroSection.astro — Full-viewport premium landing hero with HeroInteractiveCanvas React island.
 */
import HeroInteractiveCanvas from './HeroInteractiveCanvas';
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  <!-- Animated mesh gradient background -->
  <div class="hero__gradient" aria-hidden="true">
    <div class="hero__gradient-orb hero__gradient-orb--1"></div>
    <div class="hero__gradient-orb hero__gradient-orb--2"></div>
    <div class="hero__gradient-orb hero__gradient-orb--3"></div>
  </div>

  <!-- Subtle grid overlay -->
  <div class="hero__grid-overlay" aria-hidden="true"></div>

  <div class="hero__content container">
    <HeroInteractiveCanvas client:load />
  </div>

  <!-- Scroll indicator -->
  <a href="#workflows" class="hero__scroll-indicator" aria-label="Scroll down to Workflows section">
    <span class="hero__scroll-text">Scroll</span>
    <div class="hero__scroll-line" aria-hidden="true">
      <span class="hero__scroll-dot"></span>
    </div>
  </a>
</section>

<style>
  /* ================================================
     HERO SECTION
     ================================================ */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: var(--header-height);
  }

  /* — Mesh Gradient Background — */
  .hero__gradient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.35;
  }

  .hero__gradient-orb--1 {
    width: 600px;
    height: 600px;
    background: hsl(258, 80%, 50%);
    top: -15%;
    right: -10%;
    animation: float-orb-1 12s ease-in-out infinite;
  }

  .hero__gradient-orb--2 {
    width: 450px;
    height: 450px;
    background: hsl(210, 80%, 50%);
    bottom: -10%;
    left: -5%;
    animation: float-orb-2 15s ease-in-out infinite;
  }

  .hero__gradient-orb--3 {
    width: 300px;
    height: 300px;
    background: hsl(290, 75%, 55%);
    top: 40%;
    left: 30%;
    animation: float-orb-3 10s ease-in-out infinite;
  }

  @keyframes float-orb-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(-30px, 40px) scale(1.05); }
    66%      { transform: translate(20px, -20px) scale(0.95); }
  }

  @keyframes float-orb-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(40px, -30px) scale(1.08); }
    66%      { transform: translate(-20px, 30px) scale(0.92); }
  }

  @keyframes float-orb-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%      { transform: translate(30px, -40px) scale(1.1); }
  }

  /* — Grid Overlay — */
  .hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(hsla(220, 14%, 40%, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, hsla(220, 14%, 40%, 0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  /* — Content Layout — */
  .hero__content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) var(--space-6);
    z-index: var(--z-base);
    width: 100%;
  }

  /* — Scroll Indicator — */
  .hero__scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-tertiary);
    transition: color var(--transition-fast);
  }

  .hero__scroll-indicator:hover {
    color: var(--color-text-secondary);
  }

  .hero__scroll-text {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .hero__scroll-line {
    width: 1px;
    height: 40px;
    background: var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 10px;
    background: var(--color-accent);
    border-radius: var(--radius-full);
    animation: scroll-down 2s ease-in-out infinite;
  }

  @keyframes scroll-down {
    0%   { top: -10px; opacity: 0; }
    30%  { opacity: 1; }
    100% { top: 40px; opacity: 0; }
  }

  /* — Reduced motion — */
  @media (prefers-reduced-motion: reduce) {
    .hero__gradient-orb,
    .hero__scroll-dot {
      animation: none;
    }
  }
</style>
