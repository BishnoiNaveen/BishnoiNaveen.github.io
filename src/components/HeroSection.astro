---
/**
 * HeroSection.astro — Full-viewport premium landing hero.
 * Features: Dynamic mesh gradient background, staggered text entrance,
 *           floating code snippet, scroll-down indicator.
 */
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  <!-- Animated mesh gradient background -->
  <div class="hero__gradient" aria-hidden="true">
    <div class="hero__gradient-orb hero__gradient-orb--1"></div>
    <div class="hero__gradient-orb hero__gradient-orb--2"></div>
    <div class="hero__gradient-orb hero__gradient-orb--3"></div>
  </div>

  <!-- Subtle grid overlay -->
  <div class="hero__grid-overlay" aria-hidden="true"></div>

  <div class="hero__content container">
    <div class="hero__text">
      <!-- Status badge -->
      <div class="hero__status reveal" data-delay="0">
        <span class="hero__status-dot" aria-hidden="true"></span>
        <span>Available for opportunities</span>
      </div>

      <!-- Headline -->
      <h1 id="hero-heading" class="hero__heading reveal" data-delay="100">
        I'm <span class="gradient-text">Naveen Bishnoi</span>
      </h1>

      <p class="hero__subheading reveal" data-delay="200">
        AI Automation Engineer<br class="hero__br-mobile" />
        <span class="hero__ampersand">&</span> Software Architect
      </p>

      <p class="hero__description reveal" data-delay="300">
        I orchestrate AI agents to build production-grade systems —
        turning complex architectures into shipping products
        with precision engineering and automation-first thinking.
      </p>

      <!-- CTAs -->
      <div class="hero__actions reveal" data-delay="400">
        <a href="/#projects" class="hero__btn hero__btn--primary">
          <span>View Projects</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <a href="/#contact" class="hero__btn hero__btn--secondary">
          Let's Connect
        </a>
      </div>
    </div>

    <!-- Floating code card -->
    <div class="hero__visual reveal" data-delay="500">
      <div class="hero__code-card glass">
        <div class="code-card__header">
          <span class="code-card__dot code-card__dot--red" aria-hidden="true"></span>
          <span class="code-card__dot code-card__dot--yellow" aria-hidden="true"></span>
          <span class="code-card__dot code-card__dot--green" aria-hidden="true"></span>
          <span class="code-card__title">naveen.config.ts</span>
        </div>
        <pre class="code-card__body"><code><span class="code-kw">const</span> <span class="code-var">engineer</span> = {
  <span class="code-prop">name</span>: <span class="code-str">"Naveen Bishnoi"</span>,
  <span class="code-prop">role</span>: <span class="code-str">"AI Automation Engineer"</span>,
  <span class="code-prop">stack</span>: [<span class="code-str">"Python"</span>, <span class="code-str">"JS/TS"</span>, <span class="code-str">"AI"</span>],
  <span class="code-prop">passion</span>: <span class="code-str">"Building with precision"</span>,
  <span class="code-prop">status</span>: <span class="code-str">"<span class="code-blink">█</span> Ready to ship"</span>,
};</code></pre>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <a href="/#about" class="hero__scroll-indicator" aria-label="Scroll down to About section">
    <span class="hero__scroll-text">Scroll</span>
    <div class="hero__scroll-line" aria-hidden="true">
      <span class="hero__scroll-dot"></span>
    </div>
  </a>
</section>

<style>
  /* ================================================
     HERO SECTION
     ================================================ */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: var(--header-height);
  }

  /* — Mesh Gradient Background — */
  .hero__gradient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero__gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.35;
  }

  .hero__gradient-orb--1 {
    width: 600px;
    height: 600px;
    background: hsl(258, 80%, 50%);
    top: -15%;
    right: -10%;
    animation: float-orb-1 12s ease-in-out infinite;
  }

  .hero__gradient-orb--2 {
    width: 450px;
    height: 450px;
    background: hsl(210, 80%, 50%);
    bottom: -10%;
    left: -5%;
    animation: float-orb-2 15s ease-in-out infinite;
  }

  .hero__gradient-orb--3 {
    width: 300px;
    height: 300px;
    background: hsl(290, 75%, 55%);
    top: 40%;
    left: 30%;
    animation: float-orb-3 10s ease-in-out infinite;
  }

  @keyframes float-orb-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(-30px, 40px) scale(1.05); }
    66%      { transform: translate(20px, -20px) scale(0.95); }
  }

  @keyframes float-orb-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(40px, -30px) scale(1.08); }
    66%      { transform: translate(-20px, 30px) scale(0.92); }
  }

  @keyframes float-orb-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%      { transform: translate(30px, -40px) scale(1.1); }
  }

  /* — Grid Overlay — */
  .hero__grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(hsla(220, 14%, 40%, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, hsla(220, 14%, 40%, 0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }

  /* — Content Layout — */
  .hero__content {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    padding: var(--space-12) var(--space-6);
    z-index: var(--z-base);
  }

  @media (min-width: 1024px) {
    .hero__content {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-16);
    }
  }

  /* — Text — */
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-4) var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-success);
    background: hsla(152, 68%, 52%, 0.08);
    border: 1px solid hsla(152, 68%, 52%, 0.2);
    border-radius: var(--radius-full);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin-bottom: var(--space-6);
  }

  .hero__status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 8px hsla(152, 68%, 52%, 0.5);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.5; transform: scale(0.8); }
  }

  .hero__heading {
    font-size: var(--text-5xl);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-4);
  }

  .hero__subheading {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-6);
  }

  .hero__ampersand {
    color: var(--color-accent);
    margin-inline: var(--space-2);
  }

  .hero__br-mobile {
    display: block;
  }

  @media (min-width: 768px) {
    .hero__br-mobile {
      display: none;
    }
  }

  .hero__description {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 540px;
    margin-bottom: var(--space-8);
  }

  /* — CTAs — */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-8);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-full);
    transition: all var(--transition-base);
  }

  .hero__btn--primary {
    color: var(--color-bg-primary);
    background: var(--color-accent);
    box-shadow: 0 2px 16px var(--color-accent-glow);
  }

  .hero__btn--primary:hover {
    background: var(--color-accent-hover);
    box-shadow: var(--shadow-glow);
    transform: translateY(-2px);
  }

  .hero__btn--primary svg {
    transition: transform var(--transition-fast);
  }

  .hero__btn--primary:hover svg {
    transform: translateX(4px);
  }

  .hero__btn--secondary {
    color: var(--color-text-primary);
    background: transparent;
    border: 1px solid var(--color-border);
  }

  .hero__btn--secondary:hover {
    border-color: var(--color-border-hover);
    background: var(--color-accent-subtle);
  }

  /* — Code Card — */
  .hero__visual {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero__visual {
      display: block;
    }
  }

  .hero__code-card {
    padding: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    transform: perspective(800px) rotateY(-4deg) rotateX(2deg);
    transition: transform var(--transition-slow), box-shadow var(--transition-slow);
  }

  .hero__code-card:hover {
    transform: perspective(800px) rotateY(0) rotateX(0);
    box-shadow: var(--shadow-glow);
  }

  .code-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: hsla(228, 14%, 14%, 0.6);
    border-bottom: 1px solid var(--color-border);
  }

  .code-card__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .code-card__dot--red    { background: hsl(0, 72%, 55%); }
  .code-card__dot--yellow { background: hsl(42, 85%, 55%); }
  .code-card__dot--green  { background: hsl(130, 55%, 50%); }

  .code-card__title {
    margin-left: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .code-card__body {
    padding: var(--space-5) var(--space-6);
    line-height: 1.8;
    overflow-x: auto;
  }

  .code-card__body code {
    white-space: pre;
  }

  /* Syntax highlighting tokens */
  .code-kw   { color: hsl(258, 90%, 72%); }
  .code-var  { color: hsl(210, 85%, 70%); }
  .code-prop { color: hsl(195, 70%, 65%); }
  .code-str  { color: hsl(152, 60%, 58%); }

  .code-blink {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* — Scroll Indicator — */
  .hero__scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-tertiary);
    transition: color var(--transition-fast);
  }

  .hero__scroll-indicator:hover {
    color: var(--color-text-secondary);
  }

  .hero__scroll-text {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  .hero__scroll-line {
    width: 1px;
    height: 40px;
    background: var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 10px;
    background: var(--color-accent);
    border-radius: var(--radius-full);
    animation: scroll-down 2s ease-in-out infinite;
  }

  @keyframes scroll-down {
    0%   { top: -10px; opacity: 0; }
    30%  { opacity: 1; }
    100% { top: 40px; opacity: 0; }
  }

  /* — Reduced motion — */
  @media (prefers-reduced-motion: reduce) {
    .hero__gradient-orb,
    .hero__scroll-dot,
    .hero__status-dot,
    .code-blink {
      animation: none;
    }

    .hero__code-card {
      transform: none;
    }
  }
</style>
