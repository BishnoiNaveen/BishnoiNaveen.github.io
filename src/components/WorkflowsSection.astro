---
/**
 * WorkflowsSection.astro — Enterprise Systems & Multi-Agent Workflows Island.
 * Hosts Workflows React island with client:visible hydration.
 */
import Workflows from './Workflows';
---

<section class="workflows section" id="workflows" aria-labelledby="workflows-heading">
  <div class="container">
    <Workflows client:visible />
  </div>
</section>

<style>
  .workflows {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
  }
</style>
