---
/**
 * src/components/contact/ContactSection.astro — Semantic Section Wrapper for Direct Contact Chapter
 * Standard: Semantic landmarks, Section anchor #contact, visionOS surface styling
 */
import ContactTerminal from './ContactTerminal';
---

<section
  id="contact"
  aria-label="Direct Communication and Verified Contact"
  class="relative py-24 md:py-36 px-4 sm:px-6 md:px-12 lg:px-16 border-t border-[var(--color-border-subtle)] bg-[var(--color-canvas)] text-[var(--color-text-primary)] contain-layout"
>
  <div class="max-w-[96rem] mx-auto w-full">
    <ContactTerminal client:load />
  </div>
</section>
