---
/**
 * CleanContact.astro — High-Converting Contact & CTA Section
 * Glassmorphic Action Card · 1-Click Copy with Toast · Direct Socials
 */
---

<section id="contact" aria-label="Contact Naveen Bishnoi" class="py-20 md:py-28 relative">
  {/* Ambient luminous glow */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute bottom-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px] opacity-35 dark:opacity-20 blur-3xl rounded-full"
    style="background: radial-gradient(circle, rgba(0,113,227,0.25) 0%, rgba(128,32,232,0.15) 60%, transparent 80%);"
  ></div>

  <div class="relative z-10 max-w-3xl mx-auto text-center">
    {/* Section Badge */}
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full mb-4 bg-black/[0.04] dark:bg-white/[0.06] border border-black/[0.06] dark:border-white/[0.08] text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)] select-none">
      <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
      Get in Touch
    </div>

    {/* Section Title */}
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-[var(--color-text-primary)] mb-4">
      Let's build something extraordinary together.
    </h2>

    <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-xl mx-auto mb-10">
      Whether you want to discuss edge telematics, distributed storage architecture, or explore high-impact engineering leadership roles &mdash; feel free to reach out.
    </p>

    {/* Contact Card */}
    <div class="rounded-3xl p-8 sm:p-10 bg-white/80 dark:bg-[#0c101d]/85 backdrop-blur-2xl border border-black/[0.08] dark:border-white/10 shadow-[0_16px_48px_rgba(0,0,0,0.06)] dark:shadow-[0_24px_64px_rgba(0,0,0,0.6)] flex flex-col items-center gap-6">
      
      {/* Primary Action Row */}
      <div class="flex flex-col sm:flex-row items-center gap-3 w-full justify-center">
        <a
          href="mailto:0029bishnoinaveen@gmail.com"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[var(--color-accent)] hover:bg-[var(--color-accent)]/90 text-white text-sm font-semibold shadow-md shadow-[var(--color-accent)]/20 active:scale-[0.98] transition-all w-full sm:w-auto cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>Send Direct Email</span>
        </a>

        <button
          id="copy-email-btn"
          type="button"
          class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-full bg-black/[0.04] dark:bg-white/[0.08] hover:bg-black/[0.08] dark:hover:bg-white/[0.12] border border-black/[0.08] dark:border-white/[0.12] text-[var(--color-text-primary)] text-sm font-mono font-medium transition-all active:scale-[0.98] w-full sm:w-auto cursor-pointer"
        >
          <svg id="copy-icon" class="w-4 h-4 text-[var(--color-text-secondary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
          </svg>
          <span id="copy-btn-text">0029bishnoinaveen@gmail.com</span>
        </button>
      </div>

      {/* Interactive Quick Dispatch Inquiry Form */}
      <form id="contact-quick-form" class="w-full max-w-lg text-left space-y-3 pt-2">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="contact-name" class="block text-xs font-semibold text-[var(--color-text-secondary)] mb-1">Your Name</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="e.g. Systems Lead"
              class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.08] dark:border-white/10 text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition-all"
            />
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-semibold text-[var(--color-text-secondary)] mb-1">Your Email</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="name@company.com"
              class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.08] dark:border-white/10 text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition-all"
            />
          </div>
        </div>
        <div>
          <label for="contact-msg" class="block text-xs font-semibold text-[var(--color-text-secondary)] mb-1">Inquiry / Project Details</label>
          <textarea
            id="contact-msg"
            name="message"
            rows="3"
            required
            placeholder="Discussing distributed systems, IoT edge telematics, or engineering roles..."
            class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.08] dark:border-white/10 text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)] transition-all resize-none"
          ></textarea>
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-1">
          <span id="form-validation-status" class="text-xs font-mono text-[var(--color-text-secondary)] min-h-[1rem]"></span>
          <button
            type="submit"
            id="dispatch-msg-btn"
            class="px-5 py-2.5 rounded-full bg-[var(--color-accent)] text-white text-xs font-semibold tracking-tight shadow-md hover:opacity-90 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent)] cursor-pointer w-full sm:w-auto"
          >
            Dispatch Inquiry &rarr;
          </button>
        </div>
      </form>

      {/* Social and Resume Links */}
      <div class="flex flex-wrap items-center gap-6 pt-4 border-t border-black/[0.06] dark:border-white/[0.08] w-full justify-center">
        <a
          href="https://github.com/BishnoiNaveen"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
          </svg>
          <span>GitHub</span>
        </a>

        <a
          href="https://linkedin.com/in/naveen-bishnoi"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
          <span>LinkedIn</span>
        </a>

        <a
          href="/Naveen_Bishnoi_Resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Resume (PDF)</span>
        </a>
      </div>

      {/* Location note */}
      <p class="text-xs text-[var(--color-text-muted)] font-mono">
        India (IST &middot; UTC+5:30) &middot; Open to remote &amp; on-site systems architecture roles worldwide
      </p>
    </div>
  </div>
</section>

<script>
  function setupContactInteractions() {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-btn-text');
    const email = '0029bishnoinaveen@gmail.com';
    let isCopying = false;

    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        if (isCopying) return;
        isCopying = true;
        try {
          await navigator.clipboard.writeText(email);
          const originalText = copyText.textContent;
          copyText.textContent = '✓ Copied to clipboard!';
          copyBtn.classList.add('border-emerald-500', 'text-emerald-700', 'dark:text-emerald-400');

          setTimeout(() => {
            copyText.textContent = originalText;
            copyBtn.classList.remove('border-emerald-500', 'text-emerald-700', 'dark:text-emerald-400');
            isCopying = false;
          }, 2000);
        } catch (err) {
          window.location.href = `mailto:${email}`;
          isCopying = false;
        }
      });
    }

    const form = document.getElementById('contact-quick-form') as HTMLFormElement | null;
    const status = document.getElementById('form-validation-status');

    if (form && status) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('contact-name') as HTMLInputElement;
        const emailInput = document.getElementById('contact-email') as HTMLInputElement;
        const msgInput = document.getElementById('contact-msg') as HTMLTextAreaElement;

        if (!nameInput.value.trim() || !emailInput.value.trim() || !msgInput.value.trim()) {
          status.textContent = 'Please fill out all fields.';
          status.className = 'text-xs font-mono text-rose-500';
          return;
        }

        const subject = encodeURIComponent(`Inquiry from ${nameInput.value.trim()} via Portfolio`);
        const body = encodeURIComponent(
          `From: ${nameInput.value.trim()} (${emailInput.value.trim()})\n\nMessage:\n${msgInput.value.trim()}`
        );

        status.textContent = '✓ Launching mail client...';
        status.className = 'text-xs font-mono text-emerald-600 dark:text-emerald-400 font-semibold';

        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
      });
    }
  }

  setupContactInteractions();
  document.addEventListener('astro:after-swap', setupContactInteractions);
</script>
