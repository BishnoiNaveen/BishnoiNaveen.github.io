---
/**
 * ContactSection.astro — Direct Dispatch Contact Section.
 * Hosts FluidContact React island with client:visible hydration.
 */
import FluidContact from './FluidContact';
---

<section class="contact section" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <FluidContact client:visible />
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
  }
</style>
