---

<section class="contact section" id="contact" aria-labelledby="contact-heading">
  <div class="container container--narrow">
    <!-- Section Header -->
    <div class="contact__header reveal">
      <span class="section-label">Get in Touch</span>
      <h2 id="contact-heading" class="section-heading">
        Let's <span class="gradient-text">connect</span>.
      </h2>
      <p class="section-subtitle">
        I'm always open to discussing new opportunities, collaborations,
        or interesting projects. Drop me a line — I respond fast.
      </p>
    </div>

    <!-- Contact Cards -->
    <div class="contact__grid">
      {contactLinks.map((link, i) => (
        <a
          href={link.href}
          class="contact-card glass reveal"
          style={`--delay: ${i * 100}ms`}
          target={link.platform !== 'Email' ? '_blank' : undefined}
          rel={link.platform !== 'Email' ? 'noopener noreferrer' : undefined}
          aria-label={`${link.platform}: ${link.handle}`}
        >
          <div class="contact-card__icon">
            <Fragment set:html={link.icon} />
          </div>
          <div class="contact-card__info">
            <span class="contact-card__platform">{link.platform}</span>
            <span class="contact-card__handle">{link.handle}</span>
            <span class="contact-card__description">{link.description}</span>
          </div>
          <svg class="contact-card__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="contact__cta reveal">
      <p class="contact__cta-text">
        Or download my resume for a full overview.
      </p>
      <a href="/Naveen_Bishnoi_Resume.pdf" class="contact__cta-btn" target="_blank" rel="noopener" aria-label="Download Naveen Bishnoi's Resume (PDF)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span>Download Resume</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ================================================
     CONTACT SECTION
     ================================================ */
  .contact__header {
    text-align: center;
    margin-bottom: var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  /* — Contact Card — */
  .contact-card {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base), border var(--transition-base);
  }

  .contact-card:hover {
    transform: translateX(6px);
  }

  .contact-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid hsla(258, 90%, 66%, 0.12);
  }

  .contact-card__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-card__platform {
    font-size: var(--text-base);
    font-weight: 700;
  }

  .contact-card__handle {
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .contact-card__description {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .contact-card__arrow {
    color: var(--color-text-tertiary);
    transition: transform var(--transition-fast), color var(--transition-fast);
    flex-shrink: 0;
  }

  .contact-card:hover .contact-card__arrow {
    transform: translateX(4px);
    color: var(--color-accent);
  }

  /* — CTA — */
  .contact__cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .contact__cta-text {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .contact__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-8);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    transition: border-color var(--transition-fast),
                background var(--transition-fast),
                box-shadow var(--transition-fast),
                transform var(--transition-fast);
  }

  .contact__cta-btn:hover {
    border-color: var(--color-border-hover);
    background: var(--color-accent-subtle);
    box-shadow: 0 0 16px var(--color-accent-glow);
    transform: translateY(-2px);
  }
</style>
