---
/**
 * SkillsSection.astro — Technical Arsenal Section.
 * Hosts SkillsInteractiveMatrix React island with client:visible hydration.
 */
import SkillsInteractiveMatrix from './SkillsInteractiveMatrix';
---

<section class="skills section" id="skills" aria-labelledby="skills-heading">
  <div class="container">
    <SkillsInteractiveMatrix client:visible />
  </div>
</section>

<style>
  .skills {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
  }
</style>
