---
/**
 * CleanHero.astro — World-Class Landing Page Hero
 * Balanced 2-Column Split: High-Impact Human Copy + Interactive Systems Cockpit
 * Apple / Linear Aesthetic · Smooth Framer Motion Physics · 0 Bloat
 */
import InteractiveCockpit from './InteractiveCockpit';
---

<section
  id="hero"
  aria-label="Introduction"
  class="portfolio-hero relative overflow-hidden"
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
    {/* Left Column: Clear Value Proposition & Actions (7 Cols) */}
    <div class="lg:col-span-7 flex flex-col items-start text-left">
      {/* Availability Status Badge */}
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-500/[0.08] dark:bg-emerald-500/[0.15] border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 shadow-sm mb-6 select-none">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-xs font-semibold tracking-wide">
          Available for High-Impact Roles &middot; India (IST)
        </span>
      </div>

      {/* Main Headline */}
      <div class="space-y-2 mb-6">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-[var(--color-text-primary)] leading-[1.08]">
          Engineering Resilient Systems &amp; IoT at Scale.
        </h1>
        <p class="text-2xl sm:text-3xl font-bold tracking-tight bg-gradient-to-r from-[var(--color-accent)] via-purple-500 to-indigo-600 bg-clip-text text-transparent">
          Hi, I'm Naveen Bishnoi.
        </p>
      </div>

      {/* Concise, Human Intro */}
      <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-xl mb-8 font-normal">
        Software Engineer (IoT &amp; Edge Telematics) at <strong class="font-semibold text-[var(--color-text-primary)]">KRONE Agriculture India</strong>. I specialize in real-time edge telematics, deterministic POSIX storage engines, and high-throughput distributed systems.
      </p>

      {/* Primary Action Buttons */}
      <div class="flex flex-wrap items-center gap-3.5 mb-10 w-full sm:w-auto">
        <a
          href="#work"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-[var(--color-accent)] hover:bg-[var(--color-accent)]/90 text-white text-sm font-semibold shadow-md shadow-[var(--color-accent)]/20 active:scale-[0.98] transition-all cursor-pointer"
        >
          <span>Explore Projects</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </a>

        <a
          href="/Naveen_Bishnoi_Resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-full bg-black/[0.04] dark:bg-white/[0.08] hover:bg-black/[0.08] dark:hover:bg-white/[0.12] border border-black/[0.08] dark:border-white/[0.12] text-[var(--color-text-primary)] text-sm font-medium transition-all active:scale-[0.98] cursor-pointer"
        >
          <svg class="w-4 h-4 text-[var(--color-text-secondary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Download Resume</span>
        </a>

        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-1.5 px-4 py-3.5 rounded-full text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-black/[0.03] dark:hover:bg-white/[0.05] transition-colors cursor-pointer"
        >
          <span>Get in Touch</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      {/* Metrics Ribbon */}
      <div class="grid grid-cols-3 gap-4 sm:gap-6 pt-6 border-t border-black/[0.06] dark:border-white/[0.08] w-full max-w-lg">
        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight">
            50 Hz
          </div>
          <div class="text-xs text-[var(--color-text-muted)] font-medium mt-0.5">
            CAN-Bus Ingest Stream
          </div>
        </div>

        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight">
            0-Loss
          </div>
          <div class="text-xs text-[var(--color-text-muted)] font-medium mt-0.5">
            Offline WAL Protocol
          </div>
        </div>

        <div>
          <div class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight">
            4+ Yrs
          </div>
          <div class="text-xs text-[var(--color-text-muted)] font-medium mt-0.5">
            Production Engineering
          </div>
        </div>
      </div>
    </div>

    {/* Right Column: Interactive Cockpit Showcase (5 Cols) */}
    <div class="lg:col-span-5 w-full flex justify-center lg:justify-end">
      <InteractiveCockpit client:load />
    </div>
  </div>
</section>
