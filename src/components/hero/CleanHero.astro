---
/**
 * CleanHero.astro — Ultra-Clean Minimalist Hero
 * Apple / Linear Aesthetic · Zero Jargon Bloat · Pure Clarity
 */
---

<section
  id="hero"
  aria-label="Introduction"
  class="portfolio-hero relative overflow-hidden"
>
  {/* Ambient luminous glow - subtle and soft */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-16 left-1/2 -translate-x-1/2 w-[650px] h-[350px] opacity-40 dark:opacity-20 blur-3xl rounded-full"
    style="background: radial-gradient(circle, rgba(0,113,227,0.18) 0%, rgba(128,32,232,0.1) 50%, transparent 80%);"
  ></div>

  <div class="relative z-10 max-w-3xl">
    {/* Identity Header: Monogram Avatar & Status */}
    <div class="flex flex-wrap items-center gap-4 mb-8">
      {/* Sleek Monogram Badge */}
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[var(--color-accent)] to-purple-600 flex items-center justify-center text-white font-extrabold text-base tracking-tight shadow-md shadow-[var(--color-accent)]/20 select-none">
        NB
      </div>

      {/* Availability Status Badge */}
      <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-emerald-500/[0.08] dark:bg-emerald-500/[0.15] border border-emerald-500/20 text-emerald-800 dark:text-emerald-300 shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-xs font-medium tracking-wide">
          Available for new opportunities &middot; India (IST)
        </span>
      </div>
    </div>

    {/* Primary Headline */}
    <div class="space-y-2 mb-6">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-[var(--color-text-primary)] leading-[1.08]">
        Hi, I'm Naveen Bishnoi.
      </h1>
      <p class="text-xl sm:text-2xl md:text-3xl font-medium tracking-tight text-[var(--color-accent)]">
        Software Architect &amp; Systems Engineer
      </p>
    </div>

    {/* Concise Human Bio */}
    <p class="text-base sm:text-lg md:text-xl text-[var(--color-text-secondary)] leading-relaxed max-w-2xl mb-10 font-normal">
      I architect resilient distributed systems, edge telematics runtimes, and high-performance backend infrastructure. Currently leading software systems engineering at <strong class="font-semibold text-[var(--color-text-primary)]">KRONE Agriculture India</strong>, building IoT engines that operate reliably in demanding offline environments.
    </p>

    {/* Primary Action Buttons */}
    <div class="flex flex-wrap items-center gap-3.5 mb-14">
      <a
        href="#work"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[var(--color-accent)] text-white text-sm font-semibold shadow-sm hover:opacity-90 active:scale-[0.98] transition-all"
      >
        <span>View Featured Work</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </a>

      <a
        href="/Naveen_Bishnoi_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-black/[0.04] dark:bg-white/[0.08] hover:bg-black/[0.08] dark:hover:bg-white/[0.12] border border-black/[0.08] dark:border-white/[0.12] text-[var(--color-text-primary)] text-sm font-medium transition-all active:scale-[0.98]"
      >
        <svg class="w-4 h-4 text-[var(--color-text-secondary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download Resume</span>
      </a>

      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full text-sm font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-black/[0.03] dark:hover:bg-white/[0.04] transition-colors"
      >
        <span>Get in Touch</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    {/* Key Metrics / Highlights Strip */}
    <div class="clean-card p-6 grid grid-cols-2 sm:grid-cols-3 gap-6">
      <div>
        <p class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight">
          50 Hz
        </p>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] font-medium mt-1">
          CAN-Bus Edge Ingest Stream
        </p>
      </div>

      <div>
        <p class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight">
          0-Loss
        </p>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] font-medium mt-1">
          Offline Write-Ahead Log Protocol
        </p>
      </div>

      <div class="col-span-2 sm:col-span-1">
        <p class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] tracking-tight">
          4+ Yrs
        </p>
        <p class="text-xs sm:text-sm text-[var(--color-text-muted)] font-medium mt-1">
          Systems Engineering &amp; Architecture
        </p>
      </div>
    </div>
  </div>
</section>
