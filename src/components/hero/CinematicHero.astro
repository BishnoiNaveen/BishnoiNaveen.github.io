---
/**
 * src/components/hero/CinematicHero.astro — Chapter 01: Cinematic Editorial Hero
 * Composition: TYPOGRAPHY + PHOTOGRAPHY + SPACE
 * Strictly NO metric cards, NO glowing cyber boxes, NO synthetic telemetry tickers.
 */
import HeroParallaxPhoto from './HeroParallaxPhoto';
import HeroActionButtons from './HeroActionButtons';
import CinematicSection from '../Cinematic/CinematicSection';
---

<section
  id="hero"
  aria-label="Introduction and Overview"
  class="relative w-full overflow-hidden contain-layout"
>
  {/* 3D Cinematic Scroll-Jacking Neural Dive (120 WebP Frames + GSAP/Lenis) */}
  <div class="relative w-full">
    <CinematicSection client:load />
  </div>

  {/* Executive Editorial Showcase (Transition from 3D Dive to Bright Vibrant Resume) */}
  <div class="relative w-full min-h-[94vh] md:min-h-screen flex items-center justify-center pt-28 pb-16 md:pt-32 md:pb-24 px-4 sm:px-6 md:px-12 lg:px-16 overflow-hidden">
    {/* Ambient Background Aura */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[550px] bg-gradient-to-b from-[var(--color-accent)]/[0.04] via-transparent to-transparent blur-3xl -z-10"
    ></div>

  <div class="max-w-[96rem] mx-auto w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      {/* Left / Editorial Typography Column (7 Cols) */}
      <div class="lg:col-span-7 flex flex-col items-start text-left z-10">
        {/* Eyebrow Chapter & Role Label */}
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/[0.04] dark:bg-white/[0.06] border border-[var(--color-border)] mb-6 select-none">
          <span class="w-2 h-2 rounded-full bg-[var(--color-accent)] animate-pulse"></span>
          <span class="type-badge-label text-[var(--color-text-secondary)] text-[11px] font-semibold tracking-[0.08em] uppercase">
            Chapter 01 · Systems Architect &amp; AI Engineer
          </span>
        </div>

        {/* Massive Editorial Headline */}
        <h1 class="type-display-hero font-extrabold tracking-[-0.040em] leading-[0.96] text-[var(--color-text-primary)] mb-6 max-w-3xl">
          Building Resilient Systems.<br />
          <span class="text-[var(--color-text-secondary)] font-medium">
            Architecting AI Automation.
          </span>
        </h1>

        {/* Editorial Subtitle & Lead Paragraph */}
        <div class="space-y-4 mb-10 max-w-2xl">
          <p class="text-xl md:text-2xl font-semibold tracking-tight text-[var(--color-text-primary)]">
            Naveen Bishnoi — Software Architect &amp; AI Systems Engineer
          </p>
          <p class="type-subhead-lead text-[var(--color-text-secondary)] leading-relaxed text-base md:text-lg">
            Crafting fault-tolerant distributed platforms, low-level POSIX engines with proven memory invariants, and deterministic multi-agent orchestration systems. Engineering IoT telematics at KRONE Agriculture India.
          </p>
        </div>

        {/* Magnetic Action Buttons React Island */}
        <HeroActionButtons client:load />

        {/* Grounded Engineering Proof Chips (Minimal Invariants List) */}
        <div class="pt-8 border-t border-[var(--color-border-subtle)] w-full max-w-2xl">
          <div class="text-xs font-mono uppercase tracking-wider text-[var(--color-text-muted)] mb-3">
            Core Verified System Invariants
          </div>
          <div class="flex flex-wrap items-center gap-2 md:gap-3 text-xs font-mono text-[var(--color-text-secondary)]">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-black/[0.03] dark:bg-white/[0.04] border border-[var(--color-border-subtle)]">
              <svg class="w-3.5 h-3.5 text-[var(--color-success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                <path strokeLinecap="round" strokeLinejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              POSIX Atomic Inode Commit
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-black/[0.03] dark:bg-white/[0.04] border border-[var(--color-border-subtle)]">
              <svg class="w-3.5 h-3.5 text-[var(--color-success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                <path strokeLinecap="round" strokeLinejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Valgrind 0-Byte Heap Leak
            </span>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-md bg-black/[0.03] dark:bg-white/[0.04] border border-[var(--color-border-subtle)]">
              <svg class="w-3.5 h-3.5 text-[var(--color-success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                <path strokeLinecap="round" strokeLinejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              50Hz CAN Edge Ingest
            </span>
          </div>
        </div>
      </div>

      {/* Right / Photography Column (5 Cols) */}
      <div class="lg:col-span-5 flex justify-center items-center relative mt-6 lg:mt-0">
        <HeroParallaxPhoto
          client:load
          imageSrc="/images/portfolio_hero.jpg"
          altText="Naveen Bishnoi — Software Architect &amp; AI Systems Engineer"
        />
      </div>
    </div>
  </div>
  </div>
</section>
