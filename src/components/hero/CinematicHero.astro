---
/**
 * CinematicHero.astro — BEAST MODE: Dark Luxury AI Hero
 * Premium gradient hero with glassmorphism, floating orbs, stats, tech strip
 */
import HeroParallaxPhoto from './HeroParallaxPhoto';
import HeroActionButtons from './HeroActionButtons';
---

<section id="hero" aria-label="Introduction" class="relative w-full overflow-hidden">

  {/* ── BEAST MODE HERO PANEL ── */}
  <div class="relative w-full min-h-screen flex items-center overflow-hidden" style="background: #020208;">

    {/* Animated Gradient Mesh Orbs */}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      {/* Orb 1 — Indigo */}
      <div class="absolute top-[-10%] left-[-5%] w-[700px] h-[700px] rounded-full"
        style="background: radial-gradient(circle, rgba(99,102,241,0.25) 0%, transparent 70%); filter: blur(80px); animation: float-slow 8s ease-in-out infinite;"></div>
      {/* Orb 2 — Violet */}
      <div class="absolute top-[10%] right-[-10%] w-[600px] h-[600px] rounded-full"
        style="background: radial-gradient(circle, rgba(139,92,246,0.20) 0%, transparent 70%); filter: blur(80px); animation: float-slow 10s ease-in-out infinite reverse;"></div>
      {/* Orb 3 — Cyan */}
      <div class="absolute bottom-[0%] left-[30%] w-[500px] h-[500px] rounded-full"
        style="background: radial-gradient(circle, rgba(6,182,212,0.15) 0%, transparent 70%); filter: blur(80px); animation: float-slow 12s ease-in-out infinite 2s;"></div>
      {/* Grid overlay */}
      <div class="absolute inset-0 opacity-[0.03]"
        style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
      {/* Subtle dot matrix overlay */}
      <div class="absolute inset-0 opacity-[0.04]"
        style="background-image: radial-gradient(rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 32px 32px;"></div>
    </div>

    <div class="relative z-10 w-full max-w-[96rem] mx-auto px-6 md:px-12 pt-36 pb-20 md:pt-48 md:pb-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 items-center">

        {/* ── LEFT COLUMN ── */}
        <div class="lg:col-span-7 flex flex-col items-start">

          {/* Status Badge */}
          <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full mb-8 cursor-default select-none"
            style="background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25); backdrop-filter: blur(12px);">
            <span class="status-live"></span>
            <span style="font-size:0.7rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:#a5b4fc;">
              Available · Open to Opportunities
            </span>
          </div>

          {/* Chapter Eyebrow */}
          <p class="type-badge-label text-[var(--text-muted)] mb-4" style="font-size:0.72rem; letter-spacing:0.1em; text-transform:uppercase;">
            Chapter 01 · Systems Architect &amp; AI Engineer
          </p>

          {/* MASSIVE Gradient Headline */}
          <h1 class="mb-6" style="font-size: clamp(3rem,2rem + 5vw,6.5rem); font-weight:900; line-height:0.95; letter-spacing:-0.04em;">
            <span style="display:block; color: #f8fafc;">Building</span>
            <span style="display:block; background: linear-gradient(135deg, #c7d2fe 0%, #a5b4fc 30%, #818cf8 60%, #6366f1 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
              Resilient
            </span>
            <span style="display:block; color: #94a3b8; font-weight:400;">Systems.</span>
          </h1>

          {/* Subheadline */}
          <p class="mb-4" style="font-size:clamp(1.1rem, 0.9rem + 0.6vw, 1.4rem); font-weight:600; color:#e0e7ff; letter-spacing:-0.01em;">
            Naveen Bishnoi — Software Architect &amp; AI Systems Engineer
          </p>
          <p class="mb-10" style="font-size:clamp(1rem,0.9rem + 0.3vw,1.2rem); font-weight:400; color:#94a3b8; line-height:1.7; max-width:560px;">
            Crafting fault-tolerant distributed platforms, low-level POSIX engines with proven memory invariants, and deterministic multi-agent orchestration systems.
          </p>

          {/* Action Buttons */}
          <HeroActionButtons client:load />

          {/* Verified System Invariants */}
          <div class="mt-10 pt-8 w-full max-w-2xl" style="border-top: 1px solid rgba(255,255,255,0.08);">
            <p style="font-family:var(--font-mono); font-size:0.7rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--text-muted); margin-bottom:0.75rem;">
              Core Verified Invariants
            </p>
            <div class="flex flex-wrap gap-2">
              {[
                { label: 'POSIX Atomic Inode', color: '#10b981' },
                { label: 'Valgrind 0-Byte Leak', color: '#10b981' },
                { label: '50Hz CAN Edge Ingest', color: '#10b981' },
                { label: '99.9% Uptime SLA', color: '#6366f1' },
              ].map(chip => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md"
                  style={`background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); font-family:var(--font-mono); font-size:0.72rem; color:#94a3b8;`}>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke={chip.color} stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  {chip.label}
                </span>
              ))}
            </div>
          </div>
        </div>

        {/* ── RIGHT COLUMN: Photo + Stats ── */}
        <div class="lg:col-span-5 flex flex-col items-center gap-8">

          {/* Photo Frame with gradient border */}
          <div class="relative w-full max-w-md">
            {/* Gradient glow behind photo */}
            <div class="absolute -inset-4 rounded-3xl opacity-60"
              style="background: linear-gradient(135deg, rgba(99,102,241,0.4), rgba(139,92,246,0.3)); filter: blur(40px); z-index:0;"></div>
            
            {/* Animated border ring */}
            <div class="absolute -inset-[2px] rounded-3xl z-0"
              style="background: linear-gradient(135deg, rgba(99,102,241,0.8), rgba(139,92,246,0.6), rgba(6,182,212,0.5)); padding: 2px; border-radius: 24px;">
              <div style="background:#020208; border-radius: 22px; height:100%;"></div>
            </div>

            <div class="relative z-10 rounded-3xl overflow-hidden" style="aspect-ratio:4/5; border-radius:22px;">
              <HeroParallaxPhoto
                client:load
                imageSrc="/images/portfolio_hero.jpg"
                altText="Naveen Bishnoi — Software Architect"
              />
              {/* Gradient overlay on photo */}
              <div class="absolute inset-0 pointer-events-none"
                style="background: linear-gradient(180deg, transparent 60%, rgba(2,2,8,0.8) 100%);"></div>
              {/* Name overlay on photo */}
              <div class="absolute bottom-5 left-5 right-5">
                <p style="font-size:0.7rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.5); margin-bottom:4px;">Principal Engineer</p>
                <p style="font-size:1rem; font-weight:700; color:white;">KRONE Agriculture India</p>
              </div>
            </div>
          </div>

          {/* Stats Row */}
          <div class="grid grid-cols-3 gap-4 w-full max-w-md">
            {[
              { value: '3+', label: 'Years Building', color: '#818cf8' },
              { value: '12+', label: 'Systems Shipped', color: '#a78bfa' },
              { value: '∞', label: 'Coffee Consumed', color: '#67e8f9' },
            ].map(stat => (
              <div class="flex flex-col items-center p-4 rounded-2xl text-center"
                style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); backdrop-filter: blur(12px);">
                <span style={`font-size: 1.8rem; font-weight: 900; line-height:1; color: ${stat.color}; letter-spacing:-0.03em;`}>{stat.value}</span>
                <span style="font-size: 0.65rem; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:#64748b; margin-top:4px;">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* ── TECH STACK MARQUEE ── */}
      <div class="mt-20 pt-10" style="border-top: 1px solid rgba(255,255,255,0.06);">
        <p class="text-center mb-6" style="font-size:0.7rem; font-weight:600; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.2);">
          Core Technology Stack
        </p>
        <div class="relative overflow-hidden">
          <div class="flex gap-8 items-center" style="animation: marquee 25s linear infinite; width: max-content;">
            {['Rust', 'C/C++', 'Python', 'TypeScript', 'React', 'Astro', 'Three.js', 'FastAPI', 'PostgreSQL', 'Redis', 'Docker', 'Kubernetes', 'POSIX', 'CAN Bus', 'WebRTC', 'GSAP', 'LangChain', 'PyTorch', 'gRPC', 'MQTT',
              'Rust', 'C/C++', 'Python', 'TypeScript', 'React', 'Astro', 'Three.js', 'FastAPI', 'PostgreSQL', 'Redis', 'Docker', 'Kubernetes', 'POSIX', 'CAN Bus', 'WebRTC', 'GSAP', 'LangChain', 'PyTorch', 'gRPC', 'MQTT'
            ].map((tech, i) => (
              <span key={i} class="whitespace-nowrap px-5 py-2 rounded-full text-sm font-semibold select-none"
                style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: rgba(255,255,255,0.5); letter-spacing:0.02em; flex-shrink:0;">
                {tech}
              </span>
            ))}
          </div>
          {/* Fade edges */}
          <div class="absolute inset-y-0 left-0 w-24 pointer-events-none" style="background: linear-gradient(90deg, #020208, transparent);"></div>
          <div class="absolute inset-y-0 right-0 w-24 pointer-events-none" style="background: linear-gradient(270deg, #020208, transparent);"></div>
        </div>
      </div>
    </div>
  </div>
</section>
