---
/**
 * HermesSection.astro — Autonomous Multi-Agent Swarm & Memory Telemetry Island.
 * Hosts Hermes React island with client:visible hydration.
 */
import Hermes from './Hermes';
---

<section class="hermes section" id="hermes" aria-labelledby="hermes-heading">
  <div class="container">
    <Hermes client:visible />
  </div>
</section>

<style>
  .hermes {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
  }
</style>
