---
/**
 * CleanProjects.astro — Ultra-Clean Minimalist Projects
 * 4 Authentic Engineering Projects · Crisp Cards · Zero Gimmicks
 */

interface Project {
  title: string;
  tagline: string;
  description: string;
  tags: string[];
  githubUrl?: string;
  externalUrl?: string;
  externalLabel?: string;
}

const PROJECTS: Project[] = [
  {
    title: "KRONE Edge Telematics Engine",
    tagline: "Agricultural IoT & Edge Telemetry Ingest",
    description: "High-frequency IoT runtime deployed on agricultural machinery. Ingests 50Hz ISO 11783 CAN-bus telemetry, buffering data locally via an offline write-ahead log (WAL) protocol to guarantee zero packet loss across remote farming fields.",
    tags: ["C++", "Go", "CAN-Bus", "MQTT", "Protobuf", "Docker", "InfluxDB"],
    githubUrl: "https://github.com/BishnoiNaveen",
    externalUrl: "https://github.com/BishnoiNaveen",
    externalLabel: "Architecture",
  },
  {
    title: "GAMS Storage Core",
    tagline: "POSIX-Compliant Engine & Low-Level Storage",
    description: "High-assurance persistent storage engine written in C. Features atomic inode swaps for crash consistency, deterministic heap memory allocations, and verified 0-byte leaks under automated Valgrind profiling.",
    tags: ["C", "Linux / POSIX", "Valgrind", "CMake", "System Calls"],
    githubUrl: "https://github.com/BishnoiNaveen",
    externalUrl: "https://github.com/BishnoiNaveen",
    externalLabel: "Documentation",
  },
  {
    title: "Ultron Automation Engine",
    tagline: "Distributed Systems & Task Orchestration",
    description: "Distributed workflow orchestration engine executing topological dependency graphs (DAG). Features sandboxed isolated worker processes, exponential backoff retries, and real-time telemetry streaming.",
    tags: ["TypeScript", "Node.js", "Redis", "RabbitMQ", "Temporal", "Docker"],
    githubUrl: "https://github.com/BishnoiNaveen",
    externalUrl: "https://github.com/BishnoiNaveen",
    externalLabel: "Architecture",
  },
  {
    title: "Aeonis Cloud Infrastructure",
    tagline: "Cloud Platform & Site Reliability Engineering",
    description: "Multi-region cloud infrastructure management platform providing automated failover orchestration, continuous health probes, and real-time observability telemetry.",
    tags: ["Rust", "Kubernetes", "Terraform", "gRPC", "Prometheus", "AWS"],
    githubUrl: "https://github.com/BishnoiNaveen",
    externalUrl: "https://github.com/BishnoiNaveen",
    externalLabel: "Telemetry",
  },
];
---

<section id="work" aria-label="Featured Projects" class="portfolio-section relative">
  {/* Section Header */}
  <div class="mb-10 sm:mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full mb-3 bg-black/[0.04] dark:bg-white/[0.06] border border-black/[0.06] dark:border-white/[0.08] text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]">
      Featured Work
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
      Selected Projects
    </h2>
    <p class="text-base sm:text-lg text-[var(--color-text-secondary)] mt-2 max-w-xl">
      Production systems engineered for scale, deterministic reliability, and low latency.
    </p>
  </div>

  {/* Projects Grid — 2 Columns Clean Layout */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
    {PROJECTS.map((project) => (
      <article class="clean-card group relative flex flex-col justify-between p-6 sm:p-8">
        {/* Card Header & Content */}
        <div>
          <div class="flex items-center justify-between gap-4 mb-3">
            <span class="text-xs font-mono font-semibold text-[var(--color-accent)] uppercase tracking-wider">
              {project.tagline}
            </span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors mb-3">
            {project.title}
          </h3>

          <p class="text-sm sm:text-base text-[var(--color-text-secondary)] leading-relaxed mb-6 font-normal">
            {project.description}
          </p>
        </div>

        {/* Card Footer: Tech Tags & Links */}
        <div class="pt-5 border-t border-black/[0.06] dark:border-white/[0.08] flex flex-col gap-4">
          {/* Tech Pills */}
          <div class="flex flex-wrap gap-1.5 sm:gap-2">
            {project.tags.map((tag) => (
              <span class="tech-tag">
                {tag}
              </span>
            ))}
          </div>

          {/* Action Links */}
          <div class="flex items-center gap-4 pt-1">
            {project.githubUrl && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
                aria-label={`View ${project.title} on GitHub`}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                </svg>
                <span>GitHub</span>
              </a>
            )}

            {project.externalUrl && (
              <a
                href={project.externalUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--color-accent)] hover:opacity-80 transition-opacity"
              >
                <span>{project.externalLabel || "View Details"}</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
