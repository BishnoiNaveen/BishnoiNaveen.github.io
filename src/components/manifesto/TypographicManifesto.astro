---
/**
 * src/components/manifesto/TypographicManifesto.astro — Chapter 02: Architectural Thesis & Manifesto
 * Huge high-impact typography declaring the core engineering thesis:
 * "Software with Mathematical Invariants & Physical Depth"
 * 3 Core Pillars: Invariants Over Assertions, Zero Dynamic Leaks, Deterministic Automation.
 */

const PILLARS = [
  {
    number: '01',
    title: 'Invariants Over Assertions',
    headline: 'Provable state correctness by construction.',
    description:
      'State validity is mathematically guaranteed by architectural layout and type-level invariants rather than deferred to runtime try-catch handlers. Every disk mutation is crash-consistent and atomically committed via POSIX inode swaps.',
    tag: 'POSIX Atomic Inode Swap',
    iconType: 'shield',
  },
  {
    number: '02',
    title: 'Zero Dynamic Leaks',
    headline: 'Deterministic memory and resource lifecycle.',
    description:
      'Strict ownership boundaries across heap memory buffers, socket descriptors, and long-lived coroutines. Systems operate with zero uncollected allocations, verified by continuous Valgrind memory leak audits.',
    tag: 'Valgrind 0-Byte Heap Leak',
    iconType: 'cpu',
  },
  {
    number: '03',
    title: 'Deterministic Automation',
    headline: 'BFT consensus over stochastic prompt loops.',
    description:
      'Multi-agent intelligence engineered with Byzantine fault-tolerant consensus, Abstract Syntax Tree (AST) taint tracking, and strict topological DAG task resolution rather than unpredictable, unbounded loops.',
    tag: 'BFT Quorum & AST Sentry',
    iconType: 'git',
  },
];
---

<section
  id="manifesto"
  aria-label="Engineering Thesis and Core Principles"
  class="relative w-full py-24 md:py-36 lg:py-44 px-4 sm:px-6 md:px-12 lg:px-16 border-t border-[var(--color-border-subtle)] bg-[var(--color-canvas)] overflow-hidden contain-layout"
>
  <div class="max-w-[96rem] mx-auto w-full">
    {/* Chapter Header & Eyebrow */}
    <div class="flex flex-col items-start mb-16 md:mb-24">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/[0.04] dark:bg-white/[0.06] border border-[var(--color-border)] mb-8 select-none">
        <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
        <span class="type-badge-label text-[var(--color-text-secondary)] text-[11px] font-semibold tracking-[0.08em] uppercase">
          Chapter 02 · Architectural Manifesto
        </span>
      </div>

      {/* Massive Editorial Headline */}
      <h2 class="type-headline-chapter text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-[-0.035em] text-[var(--color-text-primary)] leading-[1.02] max-w-5xl mb-8">
        Software with Mathematical Invariants &amp; Physical Depth.
      </h2>

      {/* Lead Narrative Body */}
      <p class="type-subhead-lead text-lg sm:text-xl md:text-2xl text-[var(--color-text-secondary)] max-w-3xl leading-relaxed font-normal">
        Modern software has traded deterministic reliability for fragile abstraction layers. My engineering philosophy reverses that compromise: whether writing low-level POSIX C storage drivers or architecting autonomous multi-agent swarms, every system is designed around provable invariants, deterministic resource bounds, and zero runtime compromise.
      </p>
    </div>

    {/* 3 Core Pillars Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 pt-12 border-t border-[var(--color-border)]">
      {
        PILLARS.map((pillar) => (
          <article class="relative flex flex-col justify-between p-8 sm:p-10 rounded-[28px] bg-[var(--material-1-bg)] border border-[var(--color-border)] shadow-[var(--shadow-soft-md)] hover:shadow-[var(--shadow-soft-lg)] transition-all duration-300 group">
            <div>
              {/* Pillar Header */}
              <div class="flex items-center justify-between mb-8">
                <span class="font-mono text-3xl font-bold tracking-tight text-[var(--color-accent)] opacity-90">
                  {pillar.number}
                </span>
                <div class="p-3 rounded-2xl bg-black/[0.03] dark:bg-white/[0.05] text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors">
                  {pillar.iconType === 'shield' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                      <path strokeLinecap="round" strokeLinejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  )}
                  {pillar.iconType === 'cpu' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                      <path strokeLinecap="round" strokeLinejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                    </svg>
                  )}
                  {pillar.iconType === 'git' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                      <path strokeLinecap="round" strokeLinejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                    </svg>
                  )}
                </div>
              </div>

              {/* Pillar Title & Headline */}
              <h3 class="text-2xl font-bold tracking-tight text-[var(--color-text-primary)] mb-3">
                {pillar.title}
              </h3>
              <p class="text-sm font-semibold text-[var(--color-accent)] mb-4 font-mono">
                {pillar.headline}
              </p>

              {/* Pillar Description */}
              <p class="type-body-editorial text-sm sm:text-base text-[var(--color-text-secondary)] leading-relaxed mb-8">
                {pillar.description}
              </p>
            </div>

            {/* Pillar Verification Tag Footer */}
            <div class="pt-6 border-t border-[var(--color-border-subtle)] flex items-center justify-between">
              <span class="type-mono-invariant text-xs font-medium text-[var(--color-text-muted)] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)]"></span>
                {pillar.tag}
              </span>
              <svg class="w-4 h-4 text-[var(--color-text-muted)] group-hover:text-[var(--color-text-primary)] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                <path strokeLinecap="round" strokeLinejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
