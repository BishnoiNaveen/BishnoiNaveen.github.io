---
/**
 * ProjectsSection.astro — Architectural Portfolio Section.
 * Hosts ProjectsFilterGrid React island with client:visible hydration.
 */
import ProjectsFilterGrid from './ProjectsFilterGrid';
---

<section class="projects section" id="projects" aria-labelledby="projects-heading">
  <div class="container">
    <ProjectsFilterGrid client:visible />
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
  }
</style>
