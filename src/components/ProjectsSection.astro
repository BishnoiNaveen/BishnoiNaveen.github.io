---
/**
 * ProjectsSection.astro — Full-Width Editorial Featured Works & Case Studies
 * Chapter 03 of the Naveen Bishnoi Portfolio Redesign.
 */
import Projects from './Projects';
---

<section
  id="work"
  aria-label="Featured Engineering Works"
  class="relative py-20 md:py-32 px-6 md:px-12 lg:px-16 border-t border-[var(--color-border-subtle)] contain-layout"
>
  <div id="projects" class="max-w-[96rem] mx-auto w-full">
    {/* Chapter Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 md:mb-16 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/[0.04] dark:bg-white/[0.06] border border-[var(--color-border)] mb-4 select-none">
          <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
          <span class="type-badge-label text-[var(--color-text-secondary)] text-[11px] font-semibold tracking-[0.08em] uppercase">
            Chapter 03 · Featured Engineering Systems
          </span>
        </div>
        <h2 class="type-headline-chapter text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-[-0.035em] text-[var(--color-text-primary)]">
          Architecture Built for Determinism.
        </h2>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-xs font-mono font-semibold bg-black/5 dark:bg-white/10 text-[var(--color-text-primary)] hover:bg-black/10 dark:hover:bg-white/15 border border-[var(--color-border)] transition-colors"
        >
          <span>All Works &amp; Repositories</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
            <path strokeLinecap="round" strokeLinejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    {/* Full-Width Editorial Project Island */}
    <Projects client:visible />
  </div>
</section>
