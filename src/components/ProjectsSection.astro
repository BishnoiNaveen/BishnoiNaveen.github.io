---
/**
 * ProjectsSection.astro — Architectural Systems Portfolio Section.
 * Hosts Projects React island with client:visible hydration in Apple visionOS style.
 */
import Projects from './Projects';
---

<section class="projects section" id="projects" aria-labelledby="projects-heading">
  <div class="container">
    <Projects client:visible />
  </div>
</section>

<style>
  .projects {
    position: relative;
    padding: var(--space-24) 0;
    overflow: hidden;
    z-index: 10;
  }
</style>
