---
/**
 * src/components/about/EditorialAbout.astro — Long-Form Editorial Narrative & 3-Tier Timeline
 * Author: Naveen Bishnoi
 * Standard: Cinematic Scroll-Typography, Radical Honesty, 3-Tier Career Separation
 */
import { bioData } from '../../data/bio';
---

<div class="w-full max-w-[96rem] mx-auto flex flex-col gap-24 lg:gap-32">
  {/* TOP CHAPTER HEADER */}
  <header class="flex flex-col items-start max-w-4xl">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/[0.04] dark:bg-white/[0.06] border border-[var(--color-border)] mb-6 select-none">
      <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
      <span class="type-badge-label text-[var(--color-text-secondary)] text-[11px] font-semibold tracking-[0.08em] uppercase">
        Chapter 05 · Architectural Philosophy &amp; Narrative
      </span>
    </div>

    <h2 class="type-headline-chapter text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-[-0.035em] text-[var(--color-text-primary)] mb-8 leading-[1.05]">
      Software with Mathematical Invariants &amp; Physical Depth.
    </h2>

    <blockquote class="p-6 sm:p-8 rounded-2xl bg-[var(--material-1-bg)] border-l-4 border-l-[var(--color-accent)] border border-[var(--color-border)] shadow-[var(--shadow-soft-sm)] mb-8">
      <p class="type-subhead-lead text-lg sm:text-xl font-medium text-[var(--color-text-primary)] italic leading-relaxed">
        &ldquo;{bioData.leadQuote}&rdquo;
      </p>
      <footer class="mt-3 text-xs font-mono tracking-wider uppercase text-[var(--color-text-muted)]">
        — Naveen Bishnoi · Software Architect &amp; AI Systems Engineer
      </footer>
    </blockquote>
  </header>

  {/* TWO-COLUMN EDITORIAL ESSAY */}
  <section aria-label="Who I Am and How I Think" class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    {/* Left Column: Narrative Sections */}
    <div class="lg:col-span-7 flex flex-col gap-12">
      {bioData.narrativeSections.map((sec) => (
        <article class="p-6 sm:p-8 rounded-3xl bg-[var(--material-1-bg)] border border-[var(--color-border)] shadow-sm flex flex-col gap-3">
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-[var(--color-text-primary)] border-b border-[var(--color-border-subtle)] pb-3">
            {sec.title}
          </h3>
          <p class="text-sm sm:text-base text-[var(--color-text-secondary)] leading-relaxed font-normal">
            {sec.paragraphs[0]}
          </p>
        </article>
      ))}
    </div>

    {/* Right Column: 3 Core Philosophy Invariants */}
    <aside class="lg:col-span-5 flex flex-col gap-8 lg:sticky lg:top-28">
      <div class="p-8 sm:p-10 rounded-3xl bg-[var(--material-2-glass-bg)] backdrop-blur-xl border border-[var(--color-border)] shadow-[var(--shadow-glass)] flex flex-col gap-8">
        <div>
          <span class="text-[11px] font-mono font-bold tracking-[0.1em] uppercase text-[var(--color-accent)] block mb-1">
            Core System Axioms
          </span>
          <h3 class="text-2xl font-extrabold tracking-tight text-[var(--color-text-primary)]">
            How I Architect Systems
          </h3>
        </div>

        <div class="flex flex-col gap-6">
          {bioData.principles.map((pr) => (
            <div class="p-5 rounded-2xl bg-[var(--material-1-bg)] border border-[var(--color-border-subtle)] flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-[var(--color-text-muted)]">
                  PRINCIPIA // {pr.number}
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[var(--color-accent)]/10 text-[var(--color-accent)] font-semibold">
                  {pr.subtitle}
                </span>
              </div>
              <h4 class="text-base font-bold text-[var(--color-text-primary)]">
                {pr.title}
              </h4>
              <p class="text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed">
                {pr.description}
              </p>
              <div class="mt-2 pt-2 border-t border-[var(--color-border-subtle)]">
                <code class="text-[11px] font-mono text-[var(--color-accent)] block overflow-x-auto whitespace-nowrap">
                  {pr.invariant}
                </code>
              </div>
            </div>
          ))}
        </div>
      </div>
    </aside>
  </section>

  {/* CHAPTER 07: 3-TIER CAREER & ACADEMIC TIMELINE */}
  <section id="timeline" aria-label="Career and Academic Trajectory" class="flex flex-col gap-12 pt-12 border-t border-[var(--color-border-subtle)]">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/[0.04] dark:bg-white/[0.06] border border-[var(--color-border)] mb-4 select-none">
        <span class="w-2 h-2 rounded-full bg-[var(--color-success)]"></span>
        <span class="type-badge-label text-[var(--color-text-secondary)] text-[11px] font-semibold tracking-[0.08em] uppercase">
          Chapter 07 · Verified Career &amp; Academic Timeline
        </span>
      </div>
      <h3 class="type-headline-chapter text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-[-0.035em] text-[var(--color-text-primary)] mb-4">
        Verified Systems Trajectory.
      </h3>
      <p class="type-body-editorial text-base sm:text-lg text-[var(--color-text-secondary)]">
        Strict three-tier separation of corporate engineering, academic computer science foundations, and open-source systems architecture.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8">
      {bioData.timeline.map((item) => (
        <div class="p-8 sm:p-10 md:p-12 rounded-3xl bg-[var(--material-1-bg)] border border-[var(--color-border)] shadow-[var(--shadow-soft-md)] relative overflow-hidden transition-all duration-300 hover:border-[var(--color-accent)]/40">
          {/* Header Row */}
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-6 border-b border-[var(--color-border-subtle)] mb-6">
            <div class="flex flex-col gap-1">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="text-xs font-mono px-3 py-1 rounded-full font-bold uppercase tracking-wider bg-[var(--color-accent)]/10 text-[var(--color-accent)] border border-[var(--color-accent)]/20">
                  Tier {item.tier} · {item.tierLabel}
                </span>
                <span class="text-xs font-mono text-[var(--color-text-muted)]">
                  {item.period} · {item.location}
                </span>
              </div>
              <h4 class="text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)] mt-2">
                {item.title}
              </h4>
              <span class="text-base font-semibold text-[var(--color-text-secondary)]">
                {item.organization}
              </span>
            </div>

            {item.verifiedProof && (
              <div class="self-start lg:self-center">
                {item.verifiedProof.url ? (
                  <a
                    href={item.verifiedProof.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono font-semibold bg-black/[0.04] dark:bg-white/[0.08] text-[var(--color-text-primary)] hover:bg-[var(--color-accent)] hover:text-white transition-colors border border-[var(--color-border)]"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2">
                      <path strokeLinecap="round" strokeLinejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    <span>{item.verifiedProof.label}</span>
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    {item.verifiedProof.label}
                  </span>
                )}
              </div>
            )}
          </div>

          {/* Body Content */}
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <div class="lg:col-span-7 flex flex-col gap-6">
              <p class="text-base sm:text-lg text-[var(--color-text-secondary)] leading-relaxed">
                {item.summary}
              </p>
              <div class="flex flex-col gap-2.5">
                <span class="text-xs font-mono uppercase font-bold tracking-wider text-[var(--color-text-muted)]">
                  Key Engineering Responsibilities:
                </span>
                <ul class="flex flex-col gap-2">
                  {item.responsibilities.map((resp) => (
                    <li class="flex items-start gap-2.5 text-sm sm:text-base text-[var(--color-text-secondary)]">
                      <span class="text-[var(--color-accent)] font-bold mt-0.5">▹</span>
                      <span>{resp}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="lg:col-span-5 flex flex-col gap-6 bg-black/[0.02] dark:bg-white/[0.02] p-6 rounded-2xl border border-[var(--color-border-subtle)]">
              <div>
                <span class="text-xs font-mono uppercase font-bold tracking-wider text-[var(--color-text-muted)] block mb-3">
                  Verified Physical Invariants:
                </span>
                <ul class="flex flex-col gap-2">
                  {item.keyInvariants.map((inv) => (
                    <li class="flex items-center gap-2 text-xs sm:text-sm font-mono text-[var(--color-text-primary)] font-medium">
                      <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth="2.5">
                        <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{inv}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <span class="text-xs font-mono uppercase font-bold tracking-wider text-[var(--color-text-muted)] block mb-2.5">
                  Technology Stack:
                </span>
                <div class="flex flex-wrap gap-1.5">
                  {item.technologies.map((t) => (
                    <span class="px-2.5 py-1 rounded-lg text-xs font-mono bg-black/[0.04] dark:bg-white/[0.08] text-[var(--color-text-primary)] border border-[var(--color-border-subtle)]">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</div>
