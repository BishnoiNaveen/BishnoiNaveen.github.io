---
/**
 * AboutSection.astro — BEAST MODE: Dark glass panel with gradient accents
 */
import EditorialAbout from './EditorialAbout.astro';
---

<section
  id="about"
  aria-label="About Naveen Bishnoi & Architectural Narrative"
  class="relative py-20 md:py-32 px-6 md:px-12 lg:px-16 contain-layout overflow-hidden"
>
  {/* Numbers strip at top */}
  <div class="max-w-[96rem] mx-auto w-full mb-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { value: '3+', label: 'Years of Engineering', color: '#0071e3' },
        { value: '12+', label: 'Production Systems', color: '#8020e8' },
        { value: '5+', label: 'Open Source Projects', color: '#0284c7' },
        { value: '99.99%', label: 'System Invariants', color: '#10b981' },
      ].map(stat => (
        <div class="p-6 rounded-2xl text-center relative overflow-hidden bg-white/80 dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08] backdrop-blur-xl shadow-sm">
          <div class="absolute inset-0 opacity-10"
            style={`background: radial-gradient(circle at center, ${stat.color}, transparent 70%);`}></div>
          <div style={`font-size: 2.5rem; font-weight: 900; line-height:1; color: ${stat.color}; letter-spacing:-0.03em; margin-bottom: 8px;`}>
            {stat.value}
          </div>
          <div class="text-[11px] font-mono font-bold tracking-wider uppercase text-[var(--color-text-muted)]">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="max-w-[96rem] mx-auto w-full">
    <EditorialAbout />
  </div>
</section>
