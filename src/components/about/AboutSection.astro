---
/**
 * AboutSection.astro — BEAST MODE: Dark glass panel with gradient accents
 */
import EditorialAbout from './EditorialAbout.astro';
---

<section
  id="about"
  aria-label="About Naveen Bishnoi & Architectural Narrative"
  class="relative py-24 md:py-36 px-6 md:px-12 lg:px-16 contain-layout overflow-hidden"
  style="color: #f8fafc;"
>
  {/* Gradient numbers strip at top */}
  <div class="max-w-[96rem] mx-auto w-full mb-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {[
        { value: '3+', label: 'Years of Engineering', color: '#818cf8' },
        { value: '12+', label: 'Production Systems', color: '#a78bfa' },
        { value: '5+', label: 'Open Source Projects', color: '#67e8f9' },
        { value: '∞', label: 'System Invariants', color: '#34d399' },
      ].map(stat => (
        <div class="p-6 rounded-2xl text-center relative overflow-hidden"
          style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); backdrop-filter: blur(12px);">
          <div class="absolute inset-0 opacity-10"
            style={`background: radial-gradient(circle at center, ${stat.color}, transparent 70%);`}></div>
          <div style={`font-size: 2.5rem; font-weight: 900; line-height:1; color: ${stat.color}; letter-spacing:-0.03em; margin-bottom: 8px;`}>
            {stat.value}
          </div>
          <div style="font-size: 0.7rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color: rgba(255,255,255,0.4);">
            {stat.label}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="max-w-[96rem] mx-auto w-full">
    <EditorialAbout />
  </div>
</section>
