---
/**
 * ExperienceSection.astro — Career Journey, Philosophies & Competencies Bento Section.
 * Hosts Experience React island with client:visible hydration in Apple visionOS style.
 */
import Experience from './Experience';
---

<section class="experience section" id="experience" aria-labelledby="experience-heading">
  <div class="container">
    <Experience client:visible />
  </div>
</section>

<style>
  .experience {
    position: relative;
    padding: var(--space-24) 0;
    overflow: hidden;
    z-index: 10;
  }
</style>
